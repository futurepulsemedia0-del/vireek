diff --git a/src/lib/planConstants.agreement.test.ts b/src/lib/planConstants.agreement.test.ts
new file mode 100644
index 0000000..0dfb327
--- /dev/null
+++ b/src/lib/planConstants.agreement.test.ts
@@ -0,0 +1,65 @@
+import { describe, expect, it } from 'vitest';
+import { PRICING_PLANS, parseOverageRate } from '@/lib/pricing';
+import { parsePlanMinutes } from '@/lib/planChange';
+import {
+  ENTERPRISE_OVERAGE_CENTS,
+  FREE_MINUTES_INCLUDED,
+  PURCHASABLE_PLANS,
+  minutesForPlan,
+} from '../../supabase/functions/_shared/billing/planCatalog';
+import { FREE_MINUTES, PLAN_PRICE_CENTS } from '../../supabase/functions/_shared/fraud/planLimits';
+import { PLAN_MONTHLY_CENTS } from '../../supabase/functions/_shared/value-scoreboard/engine';
+
+/**
+ * pricing.ts (UI), planCatalog.ts (billing edge functions), planLimits.ts (fraud model) and the
+ * value-scoreboard engine each hold a copy of the plan numbers. This file fails if they drift.
+ */
+const plan = (id: string) => PRICING_PLANS.find((p) => p.id === id)!;
+
+describe('plan constants agree across pricing.ts, planCatalog.ts and planLimits.ts', () => {
+  it('Trial minutes: pricing.ts = planCatalog.FREE_MINUTES_INCLUDED = planLimits.FREE_MINUTES = 60', () => {
+    expect(parsePlanMinutes(plan('free').minutes)).toBe(60);
+    expect(FREE_MINUTES_INCLUDED).toBe(60);
+    expect(FREE_MINUTES).toBe(FREE_MINUTES_INCLUDED);
+    expect(minutesForPlan('free')).toBe(FREE_MINUTES_INCLUDED);
+  });
+
+  it.each(['starter', 'professional', 'business'] as const)('%s: price, minutes and overage match everywhere', (id) => {
+    const ui = plan(id);
+    const def = PURCHASABLE_PLANS.find((p) => p.id === id)!;
+    expect(PLAN_PRICE_CENTS[id]).toBe(ui.monthly! * 100);
+    expect(PLAN_MONTHLY_CENTS[id]).toBe(ui.monthly! * 100);
+    expect(def.monthlyPriceCents).toBe(ui.monthly! * 100);
+    expect(def.minutesIncluded).toBe(parsePlanMinutes(ui.minutes));
+    expect(minutesForPlan(id)).toBe(def.minutesIncluded);
+    expect(def.overageCentsPerMinute).toBe(Math.round(parseOverageRate(ui.overage)! * 100));
+  });
+
+  it('Trial and Enterprise list prices are 0 / unpriced in the server models', () => {
+    expect(PLAN_PRICE_CENTS.free).toBe(0);
+    expect(PLAN_PRICE_CENTS.enterprise).toBe(0);
+    expect(PLAN_MONTHLY_CENTS.free).toBe(0);
+    expect(plan('free').monthly).toBe(0);
+    expect(plan('enterprise').monthly).toBeNull();
+  });
+
+  it('Enterprise overage: pricing.ts string = ENTERPRISE_OVERAGE_CENTS (20c)', () => {
+    expect(ENTERPRISE_OVERAGE_CENTS).toBe(20);
+    expect(Math.round(parseOverageRate(plan('enterprise').overage)! * 100)).toBe(ENTERPRISE_OVERAGE_CENTS);
+  });
+
