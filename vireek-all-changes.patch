+import { existsSync, readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { describe, expect, it } from 'vitest';
+
+const ROOT = process.cwd();
+const text = readFileSync(join(ROOT, 'docs/compliance/policies/business-continuity.md'), 'utf8');
+const lines = text.split('\n');
+
+describe('business-continuity.md structure', () => {
+  it('stays a draft and makes no approval claim', () => {
+    expect(text).toContain('**DRAFT — not approved.**');
+    expect(text).toContain('Approved by: _pending_');
+  });
+  it('contains every required section', () => {
+    for (const h of [
+      '## 1. Critical services and recovery objectives',
+      '## 2. Role-criticality matrix',
+      '## 3. Named backup per critical system',
+      '## 4. Break-glass access procedure',
+      '## 5. Crisis plan',
+      '## 6. Crisis communication templates',
+      '## 7. Annual drill checklist',
+    ]) expect(text).toContain(h);
+  });
+  it('has customer, regulator and press templates', () => {
+    for (const t of ['### 6.1 Customers', '### 6.4 Customers — data incident notice', '### 6.5 Regulators', '### 6.6 Press', '### 6.7 Press']) expect(text).toContain(t);
+  });
+  it('marks regulator and data-incident templates as needing counsel', () => {
+    const start = text.indexOf('### 6.4');
+    const end = text.indexOf('### 6.6');
+    expect(text.slice(start, end)).toContain('[COUNSEL]');
+  });
+  it('has an annual drill checklist with checkboxes and a record table', () => {
+    const drill = text.slice(text.indexOf('## 7. Annual drill checklist'));
+    expect((drill.match(/- \[ \]/g) ?? []).length).toBeGreaterThan(15);
+    expect(drill).toContain('| Drill record |');
+  });
+});
+
+describe('business-continuity.md safety and integrity', () => {
+  it('stores no secret-looking values', () => {
+    expect(text).not.toMatch(/\b(sk|rk|pk)_(live|test)_[A-Za-z0-9]{8,}/);
+    expect(text).not.toMatch(/-----BEGIN [A-Z ]*PRIVATE KEY-----/);
+    expect(text).not.toMatch(/\beyJ[A-Za-z0-9_-]{20,}\./);
+    expect(text).not.toMatch(/\b(password|apikey|api_key|secret|token)\s*[:=]\s*[A-Za-z0-9]{8,}/i);
+  });
+  it('every backticked repository path exists', () => {
+    const paths = new Set(text.match(/`(?:docs|src|scripts|supabase|\.github)\/[A-Za-z0-9_./-]+`|`(?:RUNBOOK|ARCHITECTURE)\.md`/g)?.map((p) => p.slice(1, -1)));
+    expect(paths.size).toBeGreaterThan(10);
+    const missing = [...paths].filter((p) => !existsSync(join(ROOT, p)));
+    expect(missing).toEqual([]);
+  });
+  it('has consistent column counts in every table', () => {
+    const bad = [];
+    for (let i = 0; i < lines.length; i += 1) {
+      if (!lines[i].startsWith('|')) continue;
+      const count = (l) => (l.match(/(?<!\\)\|/g) ?? []).length;
+      const head = count(lines[i]);
+      let j = i;
+      while (j < lines.length && lines[j].startsWith('|')) {
+        if (count(lines[j]) !== head) bad.push(j + 1);
+        j += 1;
+      }
+      i = j;
+    }
+    expect(bad).toEqual([]);
+  });
+  it('gives every Tier 1 and Tier 2 role a primary and a distinct backup placeholder', () => {
+    const rows = lines.filter((l) => /^\| .* \| [12] \| \[(NAME|COUNSEL)/.test(l) || /^\| .* \| [12] \| \[NAME/.test(l));
+    expect(rows.length).toBeGreaterThanOrEqual(12);
+    for (const r of rows) {
+      const names = r.match(/\[NAME: [^\]]+\]/g) ?? [];
+      expect(names.length).toBeGreaterThanOrEqual(2);
+      expect(new Set(names).size).toBe(names.length);
+    }
+  });
+  it('is registered as evidence for the continuity control', () => {
+    const controls = JSON.parse(readFileSync(join(ROOT, 'docs/compliance/soc2/controls.json'), 'utf8'));
+    const avl04 = (controls.controls ?? controls).find((c) => c.id === 'AVL-04');
+    expect(avl04.implementation).toContain('docs/compliance/policies/business-continuity.md');
+  });
+});
