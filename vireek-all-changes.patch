+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { describe, expect, it } from 'vitest';
+import { POLICY_DIRS, collectDocs, parsePolicyApproval } from './collect-repo.mjs';
+
+describe('parsePolicyApproval', () => {
+  it('reads the DRAFT banner used by docs/compliance/policies', () => {
+    const r = parsePolicyApproval('# P\n\n> **DRAFT — not approved.** Owner: _to be assigned_ · Approved by: _pending_ · Last review: _pending_.\n');
+    expect(r.status).toBe('draft');
+    expect(r.approvedBy).toBe('pending');
+  });
+  it('reads the table layout', () => {
+    const r = parsePolicyApproval('| Status | Approved |\n| Approved by | Jane Doe |\n');
+    expect(r.status).toBe('Approved');
+    expect(r.approvedBy).toBe('Jane Doe');
+  });
+  it('ignores blank table cells (e.g. an empty sign-off row in a drill record) and falls back to the banner', () => {
+    const r = parsePolicyApproval('> **DRAFT — not approved.** Approved by: _pending_ · x\n\n| Drill record | |\n|---|---|\n| Approved by | |\n');
+    expect(r.status).toBe('draft');
+    expect(r.approvedBy).toBe('pending');
+  });
+  it('never reports "approved" for a file with neither layout', () => {
+    expect(parsePolicyApproval('# Just a document\n')).toEqual({ status: 'unknown', approvedBy: 'unknown' });
+  });
+});
+
+describe('collectDocs', () => {
+  it('scans both policy directories, skips README, and counts drafts', () => {
+    const root = mkdtempSync(join(tmpdir(), 'collect-'));
+    try {
+      for (const d of POLICY_DIRS) mkdirSync(join(root, d), { recursive: true });
+      writeFileSync(join(root, POLICY_DIRS[1], 'README.md'), '# index');
+      writeFileSync(join(root, POLICY_DIRS[1], 'a.md'), '> **DRAFT — not approved.** Approved by: _pending_ ·');
+      writeFileSync(join(root, POLICY_DIRS[0], 'b.md'), '| Status | Approved |\n| Approved by | Jane |\n');
+      const env = collectDocs({ root, now: new Date('2026-11-12T00:00:00Z') });
+      expect(env.summary.policyCount).toBe(2);
+      expect(env.summary.approved).toBe(1);
+      expect(env.summary.draft).toBe(1);
+      expect(env.data.policies.map((p) => p.file)).toEqual(['b.md', 'a.md']);
+    } finally {
+      rmSync(root, { recursive: true, force: true });
+    }
+  });
+  it('reports zero policies when neither directory exists', () => {
+    const root = mkdtempSync(join(tmpdir(), 'collect-'));
+    try {
+      expect(collectDocs({ root }).summary.policyCount).toBe(0);
+    } finally {
+      rmSync(root, { recursive: true, force: true });
+    }
+  });
+  it('finds the 15 real policy drafts, none approved', () => {
+    const env = collectDocs({ root: process.cwd() });
+    expect(env.summary.policyCount).toBe(15);
+    expect(env.summary.approved).toBe(0);
+    expect(env.data.policies.every((p) => p.status === 'draft' && p.approvedBy === 'pending')).toBe(true);
+  });
+});
