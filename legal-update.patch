+const count = (src: string) => src.split(MARKER).length - 1;
+
+function pageText(ui: ReactElement): string {
+  const { container } = render(<MemoryRouter>{ui}</MemoryRouter>);
+  return (container.textContent ?? '').replace(/\s+/g, ' ');
+}
