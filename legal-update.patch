+++ b/src/lib/trialClaims.test.ts
@@ -0,0 +1,40 @@
+import { describe, expect, it } from 'vitest';
+import { TRIAL } from '@/lib/homeContent';
+import { getClaim } from '@/lib/trust/claims';
+import en from '@/locales/en/common.json';
+import ar from '@/locales/ar/common.json';
+import de from '@/locales/de/common.json';
+import es from '@/locales/es/common.json';
+import fa from '@/locales/fa/common.json';
+import fr from '@/locales/fr/common.json';
+import hi from '@/locales/hi/common.json';
+import ja from '@/locales/ja/common.json';
+import zh from '@/locales/zh/common.json';
+
+// Marketing must not contradict Terms section 7: the trial needs a card; only the Free plan is card-free.
+describe('trial and SLA marketing claims match the legal pages', () => {
+  it('home trial copy says a card is required and no longer promises "no credit card"', () => {
+    expect(TRIAL.short).toMatch(/card required/i);
+    expect(TRIAL.short).not.toMatch(/no credit card/i);
+  });
+
+  it('every locale carries a rewritten trial and no-card string', () => {
+    const locales = { en, ar, de, es, fa, fr, hi, ja, zh } as Record<string, { finalCta: Record<string, string> }>;
+    for (const [code, loc] of Object.entries(locales)) {
+      expect(loc.finalCta.trialTerms, code).toBeTruthy();
+      expect(loc.finalCta.guaranteeNoCard, code).toBeTruthy();
+      if (code !== 'en') {
+        expect(loc.finalCta.trialTerms, code).not.toBe(en.finalCta.trialTerms);
+        expect(loc.finalCta.guaranteeNoCard, code).not.toBe(en.finalCta.guaranteeNoCard);
+      }
+    }
+    expect(en.finalCta.trialTerms).toMatch(/card required/i);
+    expect(en.finalCta.guaranteeNoCard).toMatch(/free plan/i);
+  });
+
+  it('the public SLA claim is limited to Enterprise order forms', () => {
+    const claim = getClaim('sla.uptime-commitment');
+    expect(claim.statement).toMatch(/Enterprise order forms/);
+    expect(claim.statement).not.toMatch(/99\.\d%/);
+  });
+});
