+
+const PUBLIC = join(process.cwd(), 'public');
+const brandSvgs = readdirSync(join(PUBLIC, 'brand')).filter((f) => f.endsWith('.svg'));
+
+describe('brand SVG assets', () => {
+  it('ships the full set', () => {
+    expect(brandSvgs.length).toBeGreaterThanOrEqual(24);
+  });
+  it.each(brandSvgs)('%s is < 3 KB, outlined (no text/font/image/script) and has no gradients', (f) => {
+    const raw = readFileSync(join(PUBLIC, 'brand', f), 'utf8');
+    expect(Buffer.byteLength(raw)).toBeLessThan(3000);
+    expect(raw).not.toMatch(/<text|font-family|<image|<script|Gradient/i);
+    expect(raw).toMatch(/viewBox="0 0 /);
+  });
+  it('favicon.svg is tiny (was 1.3 MB)', () => {
+    expect(statSync(join(PUBLIC, 'favicon.svg')).size).toBeLessThan(1000);
+  });
+  it('every advertised download exists', () => {
+    for (const d of BRAND_DOWNLOADS) for (const href of [d.svg, d.png]) if (href) expect(existsSync(join(PUBLIC, href))).toBe(true);
+  });
+  it('old raster logos are gone and nothing references them', () => {
+    expect(existsSync(join(PUBLIC, 'assets', 'logos', 'logo-dark.png'))).toBe(false);
+    const walk = (dir: string): string[] =>
+      readdirSync(dir, { withFileTypes: true }).flatMap((e) => (e.isDirectory() ? walk(join(dir, e.name)) : [join(dir, e.name)]));
+    const offenders = walk(join(process.cwd(), 'src'))
+      .filter((f) => /\.(tsx?|css)$/.test(f) && !f.endsWith('brandAssets.test.ts'))
+      .filter((f) => readFileSync(f, 'utf8').includes('assets/logos/'));
+    expect(offenders).toEqual([]);
+  });
+});
+
+describe('svgPathToPdfOps', () => {
+  it('converts M/L/H/V/Q/Z into jsPDF ops with scale and offset', () => {
+    const ops = svgPathToPdfOps('M0 0H10V10Q10 20 0 10Z', 2, 100, 50);
+    expect(ops[0]).toEqual({ op: 'm', c: [100, 50] });
+    expect(ops[1]).toEqual({ op: 'l', c: [120, 50] });
+    expect(ops[2]).toEqual({ op: 'l', c: [120, 70] });
+    expect(ops[3].op).toBe('c');
+    expect(ops[3].c.slice(4)).toEqual([100, 70]);
+    expect(ops[4].op).toBe('h');
+  });
+});
