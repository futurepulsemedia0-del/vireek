+  .vrk-logo--animated .vrk-logo-ring { animation: none; }
+  .vrk-logo--animated .vrk-logo-ring { display: none; }
+}
diff --git a/src/lib/brand/pdfLogo.ts b/src/lib/brand/pdfLogo.ts
new file mode 100644
index 0000000..892c475
--- /dev/null
+++ b/src/lib/brand/pdfLogo.ts
@@ -0,0 +1,56 @@
+import type { jsPDF } from 'jspdf';
+import { LOGO_SHAPES } from '@/components/brand/logoPaths.generated';
+
+/** Minimal SVG-path → jsPDF path ops (handles M L H V Q C Z, absolute — what the generator emits). */
+type Op = { op: 'm' | 'l' | 'c' | 'h'; c: number[] };
+export function svgPathToPdfOps(d: string, scale: number, ox: number, oy: number): Op[] {
+  const tokens = d.match(/[MLHVQCZ]|-?\d*\.?\d+/g) ?? [];
+  const ops: Op[] = [];
+  let i = 0, cmd = '', cx = 0, cy = 0;
+  const n = () => parseFloat(tokens[i++]);
+  const X = (v: number) => ox + v * scale;
+  const Y = (v: number) => oy + v * scale;
+  while (i < tokens.length) {
+    if (/[MLHVQCZ]/.test(tokens[i])) cmd = tokens[i++];
+    switch (cmd) {
+      case 'M': cx = n(); cy = n(); ops.push({ op: 'm', c: [X(cx), Y(cy)] }); cmd = 'L'; break;
+      case 'L': cx = n(); cy = n(); ops.push({ op: 'l', c: [X(cx), Y(cy)] }); break;
+      case 'H': cx = n(); ops.push({ op: 'l', c: [X(cx), Y(cy)] }); break;
+      case 'V': cy = n(); ops.push({ op: 'l', c: [X(cx), Y(cy)] }); break;
+      case 'Q': {
+        const qx = n(), qy = n(), x = n(), y = n();
+        ops.push({ op: 'c', c: [X(cx + (2 / 3) * (qx - cx)), Y(cy + (2 / 3) * (qy - cy)), X(x + (2 / 3) * (qx - x)), Y(y + (2 / 3) * (qy - y)), X(x), Y(y)] });
+        cx = x; cy = y; break;
+      }
+      case 'C': {
+        const a = n(), b = n(), c = n(), e = n(), x = n(), y = n();
+        ops.push({ op: 'c', c: [X(a), Y(b), X(c), Y(e), X(x), Y(y)] }); cx = x; cy = y; break;
+      }
+      case 'Z': ops.push({ op: 'h', c: [] }); break;
+      default: i++;
+    }
+  }
+  return ops;
+}
+
+/** Draws the full-colour Vireek wordmark as vector paths. Returns the drawn width in pt. */
+export function drawVireekWordmark(
+  doc: jsPDF,
+  x: number,
+  y: number,
+  height: number,
+  ink: [number, number, number] = [32, 58, 216],
+  accent: [number, number, number] = [214, 88, 42],
+): number {
+  const shape = LOGO_SHAPES.wordmark;
+  const scale = height / shape.h;
+  // jsPDF's path() only builds the path; fill() paints it (both are public API, missing from the typings).
+  const api = doc as unknown as { path: (ops: Op[]) => void; fill: () => void };
+  for (const [role, d] of shape.layers) {
+    const c = role === 'acc' ? accent : ink;
+    doc.setFillColor(c[0], c[1], c[2]);
+    api.path(svgPathToPdfOps(d, scale, x, y));
+    api.fill();
+  }
+  return shape.w * scale;
+}
