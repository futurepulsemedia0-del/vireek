+import { test, expect, type Page } from '@playwright/test';
+import { createRequire } from 'node:module';
+
+/**
+ * Logo checks: accessible name (axe), no layout shift while the logo loads,
+ * and visual snapshots in light / dark / RTL.
+ *
+ * First run on a new machine/CI image: `npx playwright test e2e/logo.spec.ts --update-snapshots`
+ * (baselines are OS/browser specific, so they are not shipped with the change).
+ * LOGO_E2E_HARNESS=1 maps routes onto a component harness (used only to verify this spec in isolation).
+ */
+const require = createRequire(import.meta.url);
+const HARNESS = process.env.LOGO_E2E_HARNESS === '1';
+const PAGES: { name: string; path: string; harness: string }[] = [
+  { name: 'home-header', path: '/', harness: '/harness.html?c=header' },
+  { name: 'brand', path: '/brand', harness: '/harness.html?c=brand' },
+  { name: 'not-found', path: '/this-page-does-not-exist', harness: '/harness.html?c=notfound' },
+];
+const url = (p: { path: string; harness: string }) => (HARNESS ? p.harness : p.path);
+
+async function prepare(page: Page, theme: 'light' | 'dark', rtl: boolean) {
+  await page.addInitScript((t) => {
+    localStorage.setItem('vireek-theme', t);
+    localStorage.setItem('vireek-consent-v2', JSON.stringify({ essential: true, analytics: false, personalization: false, marketing: false, ai: false, version: 2, timestamp: '2026-01-01T00:00:00.000Z' }));
+  }, theme);
+  if (rtl) await page.addInitScript(() => { document.addEventListener('DOMContentLoaded', () => { document.documentElement.dir = 'rtl'; }); });
+}
+
+for (const theme of ['light', 'dark'] as const) {
+  for (const rtl of [false, true]) {
+    for (const p of PAGES) {
+      test(`${p.name} · ${theme}${rtl ? ' · rtl' : ''}: logo has an accessible name and renders crisp`, async ({ page }) => {
+        await prepare(page, theme, rtl);
+        await page.goto(url(p));
+        const logo = page.getByRole('link', { name: /vireek/i }).first();
+        await expect(logo).toBeVisible();
+        const svg = logo.locator('svg').first();
+        await expect(svg).toBeVisible();
+        const box = await svg.boundingBox();
+        expect(box && box.height).toBeGreaterThan(10);
+        await expect(logo).toHaveScreenshot(`${p.name}-${theme}${rtl ? '-rtl' : ''}.png`, { animations: 'disabled', maxDiffPixelRatio: 0.01 });
+      });
+    }
+  }
+}
+
+test('axe: logo links/images have accessible names and valid ARIA', async ({ page }) => {
+  await prepare(page, 'light', false);
+  await page.goto(url(PAGES[0]));
+  await page.addScriptTag({ path: require.resolve('axe-core') });
+  const violations = await page.evaluate(async () => {
+    // @ts-expect-error injected global
+    const r = await window.axe.run(document, { runOnly: ['link-name', 'svg-img-alt', 'role-img-alt', 'aria-allowed-attr', 'aria-valid-attr-value', 'image-alt'] });
+    return r.violations.map((v: { id: string }) => v.id);
+  });
+  expect(violations).toEqual([]);
+});
+
+test('no layout shift is attributable to the logo (inline SVG with intrinsic size)', async ({ page }) => {
+  await prepare(page, 'light', false);
+  await page.addInitScript(() => {
+    (window as unknown as { __shifts: number[] }).__shifts = [];
+    new PerformanceObserver((list) => {
+      for (const e of list.getEntries() as unknown as { value: number; hadRecentInput: boolean; sources?: { node?: Node }[] }[]) {
+        if (e.hadRecentInput) continue;
+        const hitsLogo = (e.sources ?? []).some((s) => s.node instanceof Element && !!s.node.closest?.('svg.vrk-logo, a[aria-label="Vireek home"]'));
+        if (hitsLogo) (window as unknown as { __shifts: number[] }).__shifts.push(e.value);
+      }
+    }).observe({ type: 'layout-shift', buffered: true });
+  });
+  await page.goto(url(PAGES[0]));
+  await page.waitForLoadState('networkidle');
+  await page.waitForTimeout(500);
+  const shifts = await page.evaluate(() => (window as unknown as { __shifts: number[] }).__shifts);
+  expect(shifts.reduce((a, b) => a + b, 0)).toBeLessThan(0.001);
+});
