+++ b/scripts/brand/build_preview.py
@@ -0,0 +1,68 @@
+#!/usr/bin/env python3
+"""Builds docs/brand/logo-concepts.html — a single self-contained preview page with the 3 concepts."""
+import os, sys
+sys.path.insert(0, os.path.dirname(__file__))
+from concepts import *
+
+ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..'))
+def box(*ps):
+    x0, y0, x1, y1 = bounds(*[p for p in ps if p is not None]); return x0, y0, x1 - x0, y1 - y0
+def sym(id_, ink, acc):
+    x, y, w, h = box(ink, acc)
