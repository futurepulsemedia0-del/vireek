+// Vireek wordmark for HTML email. Gmail/Outlook do not render SVG, so this points at a hosted
+// 4x PNG (public/brand/email/vireek-wordmark-email.png, generated by scripts/brand/build_brand.py).
+// Pure helper — no Deno/network. Use only in emails sent as Vireek (never in white-labelled mail).
+
+export const EMAIL_LOGO_PATH = "/brand/email/vireek-wordmark-email.png";
+
+/** siteUrl may be the app origin (https://app.vireek.com); the PNG is served from the same origin. */
+export function emailLogoHtml(siteUrl: string): string {
+  const origin = siteUrl.replace(/\/$/, "");
+  return `<img src="${origin}${EMAIL_LOGO_PATH}" width="120" height="29" alt="Vireek" style="display:block;border:0;outline:none;height:29px;width:120px;margin:0 0 16px" />`;
+}
