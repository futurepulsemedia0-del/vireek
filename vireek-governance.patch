+++ b/supabase/functions/_shared/http/cronAuth.test.ts	2026-11-06 11:01:22.000000000 +0000
@@ -0,0 +1,46 @@
+import { beforeEach, describe, expect, it } from "vitest";
+import { requireCronAuth } from "./cronAuth.ts";
+
+// vitest runs on Node: provide a minimal Deno.env when the real one is absent.
+const store = new Map<string, string>();
+(globalThis as any).Deno ??= {
+  env: { get: (k: string) => store.get(k), set: (k: string, v: string) => void store.set(k, v), delete: (k: string) => void store.delete(k) },
+};
+
+const req = (h?: string) => new Request("https://x.test/", { headers: h ? { "x-cron-secret": h } : {} });
+
+describe("requireCronAuth (fail closed)", () => {
+  beforeEach(() => { Deno.env.delete("CRON_SECRET"); Deno.env.delete("CRON_SECRET_NEXT"); });
+
+  it("rejects with 503 when the secret is unset, even with no header", () => {
+    const r = requireCronAuth(req());
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.response.status).toBe(503);
+  });
+  it("rejects when secret unset and caller sends a guessed header", () => {
+    expect(requireCronAuth(req("anything")).ok).toBe(false);
+  });
+  it("treats an empty-string secret as unset", () => {
+    Deno.env.set("CRON_SECRET", "");
+    expect(requireCronAuth(req("")).ok).toBe(false);
+  });
+  it("accepts the correct secret, rejects wrong/missing with 401", () => {
+    Deno.env.set("CRON_SECRET", "s3cret-value");
+    expect(requireCronAuth(req("s3cret-value")).ok).toBe(true);
+    const bad = requireCronAuth(req("nope"));
+    expect(bad.ok).toBe(false);
+    if (!bad.ok) expect(bad.response.status).toBe(401);
+    expect(requireCronAuth(req()).ok).toBe(false);
+  });
+  it("accepts a rotation secret via extraEnvNames", () => {
+    Deno.env.set("CRON_SECRET", "old");
+    Deno.env.set("CRON_SECRET_NEXT", "new");
+    expect(requireCronAuth(req("new"), { extraEnvNames: ["CRON_SECRET_NEXT"] }).ok).toBe(true);
+  });
+  it("accepts Bearer only when allowBearer is set", () => {
+    Deno.env.set("CRON_SECRET", "tok");
+    const b = new Request("https://x.test/", { headers: { authorization: "Bearer tok" } });
+    expect(requireCronAuth(b).ok).toBe(false);
+    expect(requireCronAuth(b, { allowBearer: true }).ok).toBe(true);
+  });
+});
diff -ruN a/supabase/functions/_shared/http/cronAuth.ts b/supabase/functions/_shared/http/cronAuth.ts
--- a/supabase/functions/_shared/http/cronAuth.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/supabase/functions/_shared/http/cronAuth.ts	2026-11-06 10:55:44.000000000 +0000
@@ -0,0 +1,51 @@
+// supabase/functions/_shared/http/cronAuth.ts
+// Fail-CLOSED authentication for cron / internal service entry points.
+// Replaces the fail-open pattern:  if (cronSecret && header !== cronSecret) { 401 }
+// (which lets EVERY request through when CRON_SECRET is unset).
+import { checkSharedSecret } from "./core.ts";
+
+export interface CronAuthOptions {
+  /** Env var holding the secret. Default: CRON_SECRET */
+  envName?: string;
+  /** Headers checked in order. Default: x-cron-secret */
+  headers?: readonly string[];
+  /** Also accept `Authorization: Bearer <secret>`. Default: false */
+  allowBearer?: boolean;
+  /** Optional extra secret env names (e.g. rotation: CRON_SECRET_NEXT). */
+  extraEnvNames?: readonly string[];
+}
+
+export type CronAuthResult = { ok: true } | { ok: false; response: Response };
+
+function deny(status: number, error: string): CronAuthResult {
+  return {
+    ok: false,
+    response: new Response(JSON.stringify({ error }), {
+      status,
+      headers: { "Content-Type": "application/json" },
+    }),
+  };
+}
+
+/**
+ * Returns ok:true ONLY when a secret is configured AND the request presents it.
+ * Unset/empty secret => 503 (misconfigured, never "allow").
+ */
+export function requireCronAuth(req: Request, opts: CronAuthOptions = {}): CronAuthResult {
+  const names = [opts.envName ?? "CRON_SECRET", ...(opts.extraEnvNames ?? [])];
+  const secrets = names.map((n) => Deno.env.get(n)).filter((s): s is string => !!s && s.length > 0);
+  if (secrets.length === 0) {
+    console.error(JSON.stringify({ event: "cron_auth_misconfigured", env: names }));
+    return deny(503, "Service not configured.");
+  }
+  const headers = opts.headers ?? ["x-cron-secret"];
+  const presented: string[] = headers.map((h) => req.headers.get(h) ?? "").filter(Boolean);
+  if (opts.allowBearer) {
+    const a = req.headers.get("authorization") ?? "";
+    if (a.toLowerCase().startsWith("bearer ")) presented.push(a.slice(7).trim());
+  }
+  for (const p of presented) {
+    for (const s of secrets) if (checkSharedSecret(s, p)) return { ok: true };
+  }
+  return deny(401, "Unauthorized");
+}
diff -ruN a/supabase/functions/_shared/http/inboundSignature.test.ts b/supabase/functions/_shared/http/inboundSignature.test.ts
--- a/supabase/functions/_shared/http/inboundSignature.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/supabase/functions/_shared/http/inboundSignature.test.ts	2026-11-06 11:01:22.000000000 +0000
@@ -0,0 +1,38 @@
+import { beforeEach, describe, expect, it } from "vitest";
+import { applySigPolicy, verifyMetaSignature } from "./inboundSignature.ts";
+import { hmacSha256 } from "./webhook.ts";
+
+const store = new Map<string, string>();
+(globalThis as any).Deno ??= {
+  env: { get: (k: string) => store.get(k), set: (k: string, v: string) => void store.set(k, v), delete: (k: string) => void store.delete(k) },
+};
+
+const body = '{"entry":[{"id":"1"}]}';
+const sign = async (s: string, b = body) => "sha256=" + (await hmacSha256(s, b, "hex"));
+
+describe("verifyMetaSignature", () => {
+  it("accepts a valid signature", async () => {
+    expect((await verifyMetaSignature(body, await sign("app"), ["app"])).ok).toBe(true);
+  });
+  it("rejects wrong secret, tampered body, missing header, no secret", async () => {
+    expect((await verifyMetaSignature(body, await sign("wrong"), ["app"])).ok).toBe(false);
+    expect((await verifyMetaSignature(body + " ", await sign("app"), ["app"])).ok).toBe(false);
+    expect((await verifyMetaSignature(body, null, ["app"])).ok).toBe(false);
+    expect((await verifyMetaSignature(body, await sign("app"), [undefined, ""])).ok).toBe(false);
+  });
+  it("supports secret rotation", async () => {
+    expect((await verifyMetaSignature(body, await sign("new"), ["old", "new"])).ok).toBe(true);
+  });
+});
+
+describe("applySigPolicy", () => {
+  beforeEach(() => Deno.env.delete("WEBHOOK_SIG_MODE"));
+  it("shadow (default) lets failures through", () => {
+    expect(applySigPolicy("whatsapp", { ok: false, reason: "x" })).toBeNull();
+  });
+  it("enforce rejects failures with 403 and passes successes", () => {
+    Deno.env.set("WEBHOOK_SIG_MODE", "enforce");
+    expect(applySigPolicy("whatsapp", { ok: false, reason: "x" })?.status).toBe(403);
+    expect(applySigPolicy("whatsapp", { ok: true })).toBeNull();
+  });
+});
diff -ruN a/supabase/functions/_shared/http/inboundSignature.ts b/supabase/functions/_shared/http/inboundSignature.ts
--- a/supabase/functions/_shared/http/inboundSignature.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/supabase/functions/_shared/http/inboundSignature.ts	2026-11-06 10:58:36.000000000 +0000
