+import { beforeEach, describe, expect, it } from "vitest";
+import { governedGate, isEnforced } from "./shadowGate.ts";
+
+const store = new Map<string, string>();
+(globalThis as any).Deno ??= {
+  env: { get: (k: string) => store.get(k), set: (k: string, v: string) => void store.set(k, v), delete: (k: string) => void store.delete(k) },
+};
+const p = { userId: "u1", actionSlug: "outbound_dial", agentSource: "t" };
+const ok = (decision: string) => async () => ({ decision: decision as any, logId: "l1", existing: false });
+const boom = async () => { throw new Error("db down"); };
+
+describe("governedGate", () => {
+  beforeEach(() => Deno.env.delete("GOVERNANCE_ENFORCE"));
+
+  it("defaults to shadow", () => expect(isEnforced("outbound_dial")).toBe(false));
+  it("enforce flag: list, all, other slug", () => {
+    Deno.env.set("GOVERNANCE_ENFORCE", "outbound_dial, x");
+    expect(isEnforced("outbound_dial")).toBe(true);
+    expect(isEnforced("followup_dispatch")).toBe(false);
+    Deno.env.set("GOVERNANCE_ENFORCE", "all");
+    expect(isEnforced("anything")).toBe(true);
+  });
+  it("approved actions always allowed", async () => {
+    Deno.env.set("GOVERNANCE_ENFORCE", "all");
+    expect((await governedGate({} as any, p, ok("auto_approved"))).allow).toBe(true);
+  });
+  it("shadow: pending/rejected/error are allowed but flagged wouldBlock", async () => {
+    for (const [fn, wb] of [[ok("pending_approval"), "pending_approval"], [ok("rejected"), "rejected"], [boom, "gate_error"]] as const) {
+      const r = await governedGate({} as any, p, fn as any);
+      expect(r.allow).toBe(true);
+      expect(r.wouldBlock).toBe(wb);
+    }
+  });
+  it("enforce: pending/rejected/error are blocked (fail closed)", async () => {
+    Deno.env.set("GOVERNANCE_ENFORCE", "outbound_dial");
+    for (const fn of [ok("pending_approval"), ok("rejected"), boom]) {
+      expect((await governedGate({} as any, p, fn as any)).allow).toBe(false);
+    }
+  });
+});
diff -ruN a/supabase/functions/_shared/governance/shadowGate.ts b/supabase/functions/_shared/governance/shadowGate.ts
--- a/supabase/functions/_shared/governance/shadowGate.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/supabase/functions/_shared/governance/shadowGate.ts	2026-11-06 11:01:22.000000000 +0000
@@ -0,0 +1,48 @@
+// supabase/functions/_shared/governance/shadowGate.ts
+// Rollout wrapper around authorizeAgentAction: SHADOW first, enforce per action class.
+//   GOVERNANCE_ENFORCE=""                       -> shadow for everything (default)
+//   GOVERNANCE_ENFORCE="outbound_dial,followup_dispatch" -> enforce those slugs only
+//   GOVERNANCE_ENFORCE="all"                    -> enforce everything
+// Shadow: the decision is computed and audited, a would-block is LOGGED, the caller proceeds.
+// Enforce: pending_approval / rejected / gate error => allow=false (fail closed).
+import { authorizeAgentAction, type AuthorizeAgentActionParams } from "./agentGovernance.ts";
+import type { SupabaseClient } from "npm:@supabase/supabase-js@2.57.4";
+
+export function isEnforced(slug: string): boolean {
+  const v = (Deno.env.get("GOVERNANCE_ENFORCE") ?? "").trim();
+  if (!v) return false;
+  if (v === "all") return true;
+  return v.split(",").map((s) => s.trim()).includes(slug);
+}
+
+export interface GateResult {
+  allow: boolean;
+  enforced: boolean;
+  decision?: string;
+  logId?: string;
+  wouldBlock?: string;
+}
+
+export async function governedGate(
+  admin: SupabaseClient,
+  params: AuthorizeAgentActionParams,
+  authorize: typeof authorizeAgentAction = authorizeAgentAction,
+): Promise<GateResult> {
+  const enforced = isEnforced(String(params.actionSlug));
+  const note = (reason: string) => console.warn(JSON.stringify({
+    event: enforced ? "governance_blocked" : "governance_would_block",
+    action_slug: params.actionSlug, agent_source: params.agentSource, reason,
+  }));
+  try {
+    const a = await authorize(admin, params);
+    if (a.decision === "pending_approval" || a.decision === "rejected") {
+      note(a.decision);
+      return { allow: !enforced, enforced, decision: a.decision, logId: a.logId, wouldBlock: a.decision };
+    }
+    return { allow: true, enforced, decision: a.decision, logId: a.logId };
+  } catch (err) {
+    note("gate_error");
+    console.error(JSON.stringify({ event: "governance_gate_error", error: err instanceof Error ? err.message : String(err) }));
+    return { allow: !enforced, enforced, wouldBlock: "gate_error" };
+  }
+}
diff -ruN a/supabase/functions/_shared/http/cronAuth.test.ts b/supabase/functions/_shared/http/cronAuth.test.ts
