diff -ruN a/scripts/check-fail-open-secrets.mjs b/scripts/check-fail-open-secrets.mjs
--- a/scripts/check-fail-open-secrets.mjs	1970-01-01 00:00:00.000000000 +0000
+++ b/scripts/check-fail-open-secrets.mjs	2026-11-06 11:03:09.000000000 +0000
@@ -0,0 +1,23 @@
+// Fails (exit 1) if any Edge Function uses a fail-open secret guard.
+// Run: node scripts/check-fail-open-secrets.mjs
+import { readdirSync, readFileSync, existsSync } from "node:fs";
+import { join } from "node:path";
+const root = "supabase/functions";
+// `if (cronSecret && header !== cronSecret)` style: secret optional => unset == open
+const FAIL_OPEN = [
+  /if\s*\(\s*(cronSecret|expectedSecret|secret)\s*&&.*(!==|!=)/,
+  /if\s*\(\s*(expectedSecret)\s*\)\s*\{/,
+];
+const bad = [];
+for (const d of readdirSync(root, { withFileTypes: true })) {
+  if (!d.isDirectory() || d.name === "_shared") continue;
+  const f = join(root, d.name, "index.ts");
+  if (!existsSync(f)) continue;
+  const src = readFileSync(f, "utf8");
+  src.split("\n").forEach((line, i) => {
+    if (FAIL_OPEN.some((r) => r.test(line))) bad.push(`${f}:${i + 1}: ${line.trim()}`);
+  });
+}
+console.log(bad.length ? bad.join("\n") : "OK");
+console.log(`fail-open entry points: ${bad.length}`);
+process.exit(bad.length ? 1 : 0);
diff -ruN a/scripts/check-ungoverned-side-effects.mjs b/scripts/check-ungoverned-side-effects.mjs
--- a/scripts/check-ungoverned-side-effects.mjs	1970-01-01 00:00:00.000000000 +0000
+++ b/scripts/check-ungoverned-side-effects.mjs	2026-11-06 11:03:50.000000000 +0000
@@ -0,0 +1,36 @@
+// CI ratchet: every Edge Function with an outbound send / call / charge / refund must call
+// authorizeAgentAction OR carry `// governance-exempt: <reason>` (e.g. human-initiated).
+// Existing offenders live in scripts/governance-baseline.json; NEW offenders fail CI,
+// and the baseline can only shrink. Heuristic (text-based): it proves absence of the gate
+// call, not correctness of its placement.
+//   node scripts/check-ungoverned-side-effects.mjs            -> check
+//   node scripts/check-ungoverned-side-effects.mjs --write    -> regenerate baseline (shrink only in review)
+import { readdirSync, readFileSync, existsSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+const root = "supabase/functions";
+const baselinePath = "scripts/governance-baseline.json";
+const SIDE_EFFECT = /sendSms|sendVoiceCall|sendCompliantSms|api\.vapi\.ai\/call|api\.stripe\.com\/v1\/(refunds|payment_intents|charges)|stripe\.(refunds|paymentIntents|charges)\.create|from\(["']twilio|twilio\.com\/.*Messages|api\.twilio\.com/;
+const GATE = /authorizeAgentAction|governedGate/;
+const EXEMPT = /governance-exempt:\s*\S+/;
+const found = []; let governed = 0, exempt = 0;
+for (const d of readdirSync(root, { withFileTypes: true })) {
+  if (!d.isDirectory() || d.name === "_shared") continue;
+  const f = join(root, d.name, "index.ts");
+  if (!existsSync(f)) continue;
+  const src = readFileSync(f, "utf8");
+  if (!SIDE_EFFECT.test(src)) continue;
+  if (GATE.test(src)) governed++; else if (EXEMPT.test(src)) exempt++; else found.push(d.name);
+}
+const total = governed + exempt + found.length;
+if (process.argv.includes("--write")) {
+  writeFileSync(baselinePath, JSON.stringify({ ungoverned: found.sort() }, null, 2) + "\n");
+  console.log(`baseline written: ${found.length} ungoverned`); process.exit(0);
+}
+const base = new Set(existsSync(baselinePath) ? JSON.parse(readFileSync(baselinePath, "utf8")).ungoverned : []);
+const fresh = found.filter((n) => !base.has(n));
+const fixed = [...base].filter((n) => !found.includes(n));
+console.log(`side-effect functions: ${total} | governed: ${governed} | exempt: ${exempt} | ungoverned: ${found.length} (baseline ${base.size})`);
+console.log(`governed coverage: ${total ? ((100 * (governed + exempt)) / total).toFixed(1) : 100}%`);
+if (fixed.length) console.log(`now governed (remove from baseline via --write): ${fixed.join(", ")}`);
+if (fresh.length) { console.error(`NEW ungoverned side-effect functions:\n  ${fresh.join("\n  ")}`); process.exit(1); }
+console.log("OK: no new ungoverned side effects");
diff -ruN a/scripts/codemod-cron-auth.mjs b/scripts/codemod-cron-auth.mjs
--- a/scripts/codemod-cron-auth.mjs	1970-01-01 00:00:00.000000000 +0000
+++ b/scripts/codemod-cron-auth.mjs	2026-11-06 11:02:41.000000000 +0000
@@ -0,0 +1,39 @@
+// Migrates fail-open `if (cronSecret && req.headers.get("X-Cron-Secret") !== cronSecret) {...}` guards
+// to requireCronAuth(). Idempotent. Usage: node scripts/codemod-cron-auth.mjs [--dry]
+import { readdirSync, readFileSync, writeFileSync, existsSync } from "node:fs";
+import { join } from "node:path";
+const dry = process.argv.includes("--dry");
+const root = "supabase/functions";
+const GUARD = /^(\s*)if \(cronSecret && req\.headers\.get\("X-Cron-Secret"\) !== cronSecret\)\s*(\{)?(.*)$/;
+const IMPORT_LINE = /^(import\b.*|\}\s*from\s*["'][^"']+["']);\s*$/;
+const changed = [], skipped = [];
+for (const d of readdirSync(root, { withFileTypes: true })) {
+  if (!d.isDirectory() || d.name === "_shared") continue;
+  const f = join(root, d.name, "index.ts");
+  if (!existsSync(f)) continue;
+  const lines = readFileSync(f, "utf8").split("\n");
+  const gi = lines.findIndex((l) => GUARD.test(l));
+  if (gi < 0) continue;
+  const m = lines[gi].match(GUARD); const indent = m[1];
+  let end = gi;
+  if (m[2]) { // block form: find matching close brace
+    let depth = 0;
+    for (let i = gi; i < lines.length; i++) {
+      for (const ch of lines[i]) { if (ch === "{") depth++; else if (ch === "}") depth--; }
+      if (depth === 0) { end = i; break; }
+    }
+    if (end === gi && !lines[gi].includes("}")) { skipped.push(`${f}: unbalanced`); continue; }
+  }
+  lines.splice(gi, end - gi + 1, `${indent}const cronAuth = requireCronAuth(req);`, `${indent}if (!cronAuth.ok) return cronAuth.response;`);
+  let src = lines.join("\n");
+  // drop now-unused `const cronSecret = ...;` (only if no other reference remains)
+  const decl = /^\s*const cronSecret = Deno\.env\.get\("CRON_SECRET"\);\s*\n/m;
+  if (decl.test(src) && (src.match(/\bcronSecret\b/g) || []).length === 1) src = src.replace(decl, "");
+  const arr = src.split("\n");
+  let last = -1; arr.forEach((l, i) => { if (IMPORT_LINE.test(l)) last = i; });
+  if (last < 0) { skipped.push(`${f}: no import anchor`); continue; }
+  arr.splice(last + 1, 0, `import { requireCronAuth } from "../_shared/http/cronAuth.ts";`);
+  if (!dry) writeFileSync(f, arr.join("\n"));
+  changed.push(f);
+}
+console.log(`${dry ? "[dry] " : ""}migrated ${changed.length}`); if (skipped.length) console.log("skipped:\n" + skipped.join("\n"));
