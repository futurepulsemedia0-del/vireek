--- vireek-orig/src/lib/themeColors.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ vireek-main/src/lib/themeColors.test.ts	2026-11-07 03:48:58.741720351 +0000
@@ -0,0 +1,43 @@
+import { afterEach, describe, expect, it } from 'vitest';
+import { BRAND_COLORS } from '@/styles/tokens.generated';
+import { currentTheme, subscribeTheme, tokenHex, tokenRgba } from './themeColors';
+
+afterEach(() => {
+  document.documentElement.className = '';
+  document.documentElement.removeAttribute('style');
+});
+
+describe('themeColors', () => {
+  it('falls back to the generated light table when no CSS variable is defined', () => {
+    expect(currentTheme()).toBe('light');
+    expect(tokenHex('accent-graphic')).toBe(BRAND_COLORS.light['accent-graphic']);
+  });
+
+  it('uses the dark table when <html> carries the dark class', () => {
+    document.documentElement.classList.add('dark');
+    expect(currentTheme()).toBe('dark');
+    expect(tokenHex('accent-graphic')).toBe(BRAND_COLORS.dark['accent-graphic']);
+  });
+
+  it('treats the dark high-contrast toggle as dark', () => {
+    document.documentElement.classList.add('a11y-dark-contrast');
+    expect(currentTheme()).toBe('dark');
+  });
+
+  it('formats rgba() with comma syntax that canvas and MapLibre accept', () => {
+    expect(tokenRgba('static-black', 0.5)).toBe('rgba(0, 0, 0, 0.5)');
+  });
+
+  it('notifies subscribers when the theme class flips and stops after unsubscribe', async () => {
+    let calls = 0;
+    const off = subscribeTheme(() => { calls += 1; });
+    document.documentElement.classList.add('dark');
+    await new Promise((r) => setTimeout(r, 0));
+    expect(calls).toBeGreaterThan(0);
+    off();
+    const before = calls;
+    document.documentElement.classList.remove('dark');
+    await new Promise((r) => setTimeout(r, 0));
+    expect(calls).toBe(before);
+  });
+});
diff -ruN vireek-orig/src/lib/themeColors.ts vireek-main/src/lib/themeColors.ts
--- vireek-orig/src/lib/themeColors.ts	1970-01-01 00:00:00.000000000 +0000
+++ vireek-main/src/lib/themeColors.ts	2026-11-07 03:45:53.294026993 +0000
@@ -0,0 +1,47 @@
+// src/lib/themeColors.ts
+// Resolves design tokens to concrete colour strings for APIs that cannot take CSS variables
+// (<canvas>, MapLibre paint properties). Everything else should use Tailwind token classes or `rgb(var(--token))`.
+//
+// Resolution order: the live CSS custom property (so high-contrast / theme switches are honoured), then the
+// generated per-theme hex table (SSR, tests, or a token that is not defined yet).
+import { BRAND_COLORS } from '@/styles/tokens.generated';
+
+export type ThemeName = 'light' | 'dark';
+export type TokenKey = keyof (typeof BRAND_COLORS)['light'];
+
+export function currentTheme(): ThemeName {
+  if (typeof document === 'undefined') return 'light';
+  const cl = document.documentElement.classList;
+  return cl.contains('dark') || cl.contains('a11y-dark-contrast') ? 'dark' : 'light';
+}
+
+function toHex(n: number): string {
+  return Math.max(0, Math.min(255, Math.round(n))).toString(16).padStart(2, '0');
+}
+
+/** Concrete `#rrggbb` for a token in the active theme. */
+export function tokenHex(key: TokenKey): string {
+  if (typeof document !== 'undefined') {
+    const raw = getComputedStyle(document.documentElement).getPropertyValue(`--${key}`).trim();
+    const m = /^(\d{1,3})[\s,]+(\d{1,3})[\s,]+(\d{1,3})$/.exec(raw);
+    if (m) return `#${toHex(Number(m[1]))}${toHex(Number(m[2]))}${toHex(Number(m[3]))}`;
+  }
+  return BRAND_COLORS[currentTheme()][key];
+}
+
+/** `rgba(r, g, b, a)` (comma syntax: accepted by canvas and MapLibre) for a token with opacity. */
+export function tokenRgba(key: TokenKey, alpha: number): string {
+  const hex = tokenHex(key);
+  const r = parseInt(hex.slice(1, 3), 16);
+  const g = parseInt(hex.slice(3, 5), 16);
+  const b = parseInt(hex.slice(5, 7), 16);
+  return `rgba(${r}, ${g}, ${b}, ${alpha})`;
+}
+
+/** Calls `cb` whenever the active theme (class on <html>) changes. Returns an unsubscribe function. */
+export function subscribeTheme(cb: () => void): () => void {
+  if (typeof document === 'undefined' || typeof MutationObserver === 'undefined') return () => undefined;
+  const mo = new MutationObserver(() => cb());
+  mo.observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'data-theme'] });
+  return () => mo.disconnect();
+}
