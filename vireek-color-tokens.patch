+// e2e/color-contrast-routes.spec.ts — axe `color-contrast` on 25 public routes in light AND dark, plus a light/dark
+// parity check (same page structure in both themes). Theme is forced through the app's own storage key.
+// Run: npx playwright test e2e/color-contrast-routes.spec.ts
+import { test, expect, type Page } from '@playwright/test';
+import AxeBuilder from '@axe-core/playwright';
+
+const ROUTES = [
+  '/', '/pricing', '/features', '/platform', '/solutions', '/industries', '/compare', '/enterprise', '/services',
+  '/about', '/manifesto', '/contact', '/faq', '/help', '/docs', '/blog', '/glossary', '/testimonials',
+  '/login', '/signup', '/forgot-password', '/privacy', '/terms', '/cookies', '/accessibility-statement',
+] as const;
+const THEMES = ['light', 'dark'] as const;
+
+async function open(page: Page, path: string, theme: (typeof THEMES)[number]) {
+  await page.emulateMedia({ colorScheme: theme, reducedMotion: 'reduce' });
+  await page.addInitScript((t) => { try { localStorage.setItem('vireek-theme', t); } catch { /* ignore */ } }, theme);
+  await page.goto(path);
+  await page.waitForLoadState('networkidle');
+  await expect(page.locator('html')).toHaveClass(theme === 'dark' ? /dark/ : /^(?!.*\bdark\b).*$/);
+}
+
+for (const theme of THEMES) {
+  for (const path of ROUTES) {
+    test(`color-contrast ${path} [${theme}]`, async ({ page }) => {
+      await open(page, path, theme);
+      const results = await new AxeBuilder({ page }).withRules(['color-contrast']).analyze();
+      expect(results.violations, JSON.stringify(results.violations.map((v) => v.nodes.map((n) => n.target)), null, 2)).toEqual([]);
+    });
+  }
+}
+
+// Parity: theming must change colours only, never structure or content.
+const structure = (page: Page) =>
+  page.evaluate(() => ({
+    h1: document.querySelector('h1')?.textContent?.trim() ?? '',
+    headings: document.querySelectorAll('h1,h2,h3').length,
+    links: document.querySelectorAll('a[href]').length,
+    buttons: document.querySelectorAll('button').length,
+    images: document.querySelectorAll('img,svg').length,
+  }));
+
+for (const path of ROUTES) {
+  test(`light/dark parity ${path}`, async ({ browser }) => {
+    const seen: Record<string, Awaited<ReturnType<typeof structure>>> = {};
+    for (const theme of THEMES) {
+      const ctx = await browser.newContext();
+      const page = await ctx.newPage();
+      await open(page, path, theme);
+      seen[theme] = await structure(page);
+      await ctx.close();
+    }
+    expect(seen.dark).toEqual(seen.light);
+  });
+}
