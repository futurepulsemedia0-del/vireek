+    }
+  }
+})(join(ROOT, 'src'));
+
+const rows = Object.entries(c.byCat).sort((a, b) => b[1].lines - a[1].lines)
+  .map(([k, v]) => `| ${k} | ${v.files.size} | ${v.lines} |`).join('\n');
+const md = `# Colour inventory (generated — \`node scripts/color/inventory.mjs\`)
+
+Measured on the current working tree with the same patterns as \`scripts/color/check-colors.mjs\`.
+
+| Metric | Count |
+|---|---|
+| lines with a raw Tailwind palette class | ${c.raw} |
+| lines with a palette-scale class on a UI utility | ${c.scale} |
+| \`dark:\` class occurrences (remaining) | ${c.dark} |
+| lines with a hex / rgb() / hsl() literal | ${c.hexLines} in ${c.hexFiles.size} files |
+
+## Remaining literals by purpose
+
+| Allowlist category | Files | Lines |
+|---|---|---|
+${rows}
+
+Each category's reason is stored in \`scripts/color/color-allowlist.json\` (\`categories\`). Anything under "NOT ON ALLOWLIST" fails \`npm run lint:colors\`.
+`;
+writeFileSync(join(ROOT, 'docs/design/color-inventory.md'), md);
+console.log(md);
