+++ vireek-main/scripts/color/guards.test.ts	2026-11-07 03:48:58.742814070 +0000
@@ -0,0 +1,38 @@
+// scripts/color/guards.test.ts — invariants for the colour allowlist and the theme-aware elevation tokens.
+import { describe, it, expect } from 'vitest';
+import { existsSync, readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = join(fileURLToPath(new URL('.', import.meta.url)), '..', '..');
+const allow = JSON.parse(readFileSync(join(ROOT, 'scripts/color/color-allowlist.json'), 'utf8')) as {
+  categories: Record<string, string>;
+  files: Record<string, { category: string; max: number }>;
+};
+const css = readFileSync(join(ROOT, 'src/styles/tokens.generated.css'), 'utf8');
+const tw = readFileSync(join(ROOT, 'tailwind.config.js'), 'utf8');
+
+describe('colour allowlist', () => {
+  it('every category has a written reason (>= 30 chars)', () => {
+    for (const [k, reason] of Object.entries(allow.categories)) expect(reason.length, k).toBeGreaterThanOrEqual(30);
+  });
+  it('every entry points at an existing file with a documented category and a positive max', () => {
+    for (const [rel, e] of Object.entries(allow.files)) {
+      expect(existsSync(join(ROOT, rel)), rel).toBe(true);
+      expect(allow.categories[e.category], `${rel} category`).toBeTruthy();
+      expect(e.max, rel).toBeGreaterThan(0);
+    }
+  });
+});
+
+describe('elevation tokens', () => {
+  it('defines --shadow-card and --shadow-card-hover in every theme block (light, dark, light-HC, dark-HC)', () => {
+    expect((css.match(/--shadow-card:/g) ?? []).length).toBeGreaterThanOrEqual(4);
+    expect((css.match(/--shadow-card-hover:/g) ?? []).length).toBeGreaterThanOrEqual(4);
+  });
+  it('Tailwind maps shadow-card to the variable, and the dark-only shadow utilities are gone', () => {
+    expect(tw).toContain("card: 'var(--shadow-card)'");
+    expect(tw).toContain("'card-hover': 'var(--shadow-card-hover)'");
+    expect(tw).not.toMatch(/card-dark|card-hover-dark/);
+  });
+});
