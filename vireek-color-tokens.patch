+#!/usr/bin/env node
+// scripts/color/inventory.mjs — `node scripts/color/inventory.mjs` writes docs/design/color-inventory.md
+// Re-measures raw colour usage in src/**/*.{ts,tsx,css} with the SAME patterns as check-colors.mjs and classifies
+// every remaining hex/rgb()/hsl() literal line by purpose (path heuristics; refine in ALLOW_REASON below).
+import { readFileSync, readdirSync, statSync, writeFileSync } from 'node:fs';
+import { join, relative, extname, sep } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = join(fileURLToPath(new URL('.', import.meta.url)), '..', '..');
+const PAL = '(?:slate|gray|zinc|neutral|stone|red|rose|orange|amber|yellow|green|emerald|lime|teal|blue|sky|cyan|indigo|violet|purple|fuchsia|pink)';
+const RAW = new RegExp(`(?<![\\w-])(?:[a-z0-9-]+:)*!?(?:bg|text|border|ring|outline|divide|from|via|to|fill|stroke|placeholder|decoration|caret|shadow|accent)-${PAL}-\\d{2,3}`);
+const SCALE = /(?<![\w-])(?:[a-z0-9-]+:)*!?(?:bg|text|border|ring|outline|divide|fill|stroke)-(?:accent|cta|success|danger|warning|info)-\d{2,3}\b/;
+const HEX = /#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3})\b/;
+const FN = /\b(?:rgba?|hsla?|hwb)\(\s*(?!var\()[\d.]/;
+const DARK = /(?<![\w-])dark:[^\s"'`]+/g;
+const SKIP = /(tokens\.generated|\.test\.|\.spec\.)/;
+
+const ALLOW = JSON.parse(readFileSync(join(ROOT, 'scripts/color/color-allowlist.json'), 'utf8'));
+const cat = (rel) => ALLOW.files[rel]?.category ?? 'NOT ON ALLOWLIST (violation)';
+
+const c = { raw: 0, scale: 0, hexLines: 0, hexFiles: new Set(), dark: 0, byCat: {} };
+(function walk(d) {
+  for (const e of readdirSync(d)) {
+    const f = join(d, e);
+    if (statSync(f).isDirectory()) { if (e !== 'node_modules') walk(f); continue; }
+    if (!['.ts', '.tsx', '.css'].includes(extname(e)) || SKIP.test(f)) continue;
+    const rel = relative(ROOT, f).split(sep).join('/');
+    for (const line of readFileSync(f, 'utf8').split('\n')) {
+      const t = line.trim();
+      if (t.startsWith('//') || t.startsWith('*') || t.startsWith('/*') || /color-ok:/.test(line)) continue;
+      if (RAW.test(line)) c.raw++;
+      if (SCALE.test(line)) c.scale++;
+      c.dark += (line.match(DARK) ?? []).length;
