{
  "openapi": "3.1.0",
  "info": {
    "title": "Vireek API",
    "summary": "Read-only REST API for your Vireek calls, leads and jobs.",
    "version": "1.0.0",
    "description": "Read-only access to your Vireek calls, leads and jobs.\n\n**Authentication** — send a scoped API key as `Authorization: Bearer vrk_live_…`. Create, rotate and revoke keys under Settings → API Keys. Every request is logged per key.\n\n**Rate limit** — 120 requests per minute per key. Exceeding it returns `429` with a `Retry-After` header.\n\n**Pagination** — list endpoints return newest first as `{ data, has_more, next_before }`. Pass `next_before` back as `before` for the next page (`limit`: 1–100, default 25).\n\nOnly `GET` is supported; other methods return `405`.",
    "contact": {
      "name": "Vireek Developers",
      "url": "https://vireek.com/developers/api-reference"
    }
  },
  "servers": [
    {
      "url": "https://tagpfcwwxnmsmjneciqh.supabase.co/functions/v1/api-v1",
      "description": "Vireek API"
    }
  ],
  "tags": [
    {
      "name": "Calls",
      "description": "Inbound calls handled by your AI receptionist — recordings, transcripts, summaries and sentiment."
    },
    {
      "name": "Leads",
      "description": "Leads captured from calls."
    },
    {
      "name": "Jobs",
      "description": "Booked and scheduled jobs."
    }
  ],
  "externalDocs": {
    "description": "Guides & webhooks",
    "url": "https://vireek.com/docs"
  },
