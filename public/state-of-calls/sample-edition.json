    "mode": "report",
    "sections": [
      {
        "id": "headline",
        "title": "Headline findings",
        "statements": [
          {
            "id": "answer-rate",
            "cites": [
              "answer_rate|national|all|2026"
            ],
            "derived": [],
            "text": "Across roughly 80 contributing businesses, 83% of inbound non-spam calls were answered. The middle half of businesses answered between 80% and 88% of their calls."
          },
          {
            "id": "missed-rate",
            "cites": [
              "missed_call_rate|national|all|2026"
            ],
            "derived": [],
            "text": "17% of those calls were missed or went to voicemail."
          },
          {
            "id": "after-hours",
            "cites": [
              "after_hours_share|national|all|2026"
            ],
            "derived": [],
            "text": "29% of calls arrived outside the business's own opening hours."
          },
          {
            "id": "emergency",
            "cites": [
              "emergency_share|national|all|2026"
            ],
            "derived": [],
            "text": "10% of calls were flagged as emergencies."
          },
          {
            "id": "booking",
            "cites": [
              "booking_conversion|national|all|2026"
            ],
            "derived": [],
            "text": "43% of answered calls ended in a booking."
          },
          {
            "id": "ticket",
            "cites": [
              "avg_ticket_usd|national|all|2026"
            ],
            "derived": [],
            "text": "The average invoice on completed jobs was $550."
          },
          {
            "id": "first-response",
            "cites": [
              "lead_first_response_minutes|national|all|2026"
            ],
            "derived": [],
            "text": "The typical business took 10 minutes to first respond to a new lead."
          }
        ]
      },
      {
        "id": "trade",
        "title": "By trade",
        "statements": [
          {
            "id": "trade-gap",
            "cites": [
              "missed_call_rate|trade|plumbing|2026",
              "missed_call_rate|trade|hvac|2026"
            ],
            "derived": [
              2
            ],
            "text": "Among trades with enough data, missed-call rates ranged from 15% (plumbing) to 17% (hvac), a gap of 2 percentage points. Differences may reflect the mix of businesses contributing, not the trade itself."
          }
        ]
      },
      {
        "id": "region",
        "title": "By region",
        "statements": [
          {
            "id": "region-gap",
            "cites": [
              "missed_call_rate|region|northeast|2026",
              "missed_call_rate|region|south|2026"
            ],
            "derived": [],
            "text": "By US Census region, missed-call rates ranged from 12% (northeast) to 18% (south)."
          }
        ]
      },
      {
        "id": "seasonality",
        "title": "Seasonality",
        "statements": [
          {
            "id": "season-peak",
            "cites": [
              "seasonality_index|season|m07|2026",
              "seasonality_index|season|m11|2026"
            ],
            "derived": [
              100
            ],
            "text": "Among months with enough data, call volume peaked in July at an index of 114 and was lowest in November at 87 (100 = an average month)."
          }
        ]
      },
      {
        "id": "language",
        "title": "Language mix",
        "statements": [
          {
            "id": "language-top",
            "cites": [
              "language_share|language|english|2026"
            ],
            "derived": [],
            "text": "91% of calls with a detected language were in english."
          }
        ]
      }
    ],
    "reasons": []
  },
  "metrics": [
    {
      "key": "answer_rate",
      "label": "Answer rate",
      "unit": "percent",
      "definition": "Share of inbound, non-spam calls that were answered (not missed and not sent to voicemail).",
      "event_label": "calls"
    },
    {
      "key": "missed_call_rate",
      "label": "Missed-call rate",
      "unit": "percent",
      "definition": "Share of inbound, non-spam calls recorded as missed or sent to voicemail. Equals 100% minus the answer rate.",
      "event_label": "calls"
    },
    {
      "key": "after_hours_share",
      "label": "After-hours share",
      "unit": "percent",
      "definition": "Share of inbound, non-spam calls that arrived outside the business's own configured opening hours, in the business's own time zone. Holidays are not modelled.",
      "event_label": "calls"
    },
    {
      "key": "emergency_share",
      "label": "Emergency share",
      "unit": "percent",
      "definition": "Share of inbound, non-spam calls flagged as an emergency by the business's call handling rules.",
      "event_label": "calls"
    },
    {
      "key": "booking_conversion",
      "label": "Booking conversion",
      "unit": "percent",
      "definition": "Share of answered, non-spam calls whose status is 'booked'.",
      "event_label": "answered calls"
    },
    {
      "key": "lead_first_response_minutes",
      "label": "Speed to first response (leads)",
      "unit": "minutes",
      "definition": "Median across businesses of each business's median minutes from lead creation to first response. Call answer latency is not recorded per call, so this is NOT speed-to-answer.",
      "event_label": "leads"
    },
    {
      "key": "avg_ticket_usd",
      "label": "Average ticket",
      "unit": "usd",
      "definition": "Average invoice amount of completed jobs with an invoice, rounded to the nearest $25.",
      "event_label": "completed jobs"
    },
    {
      "key": "seasonality_index",
      "label": "Seasonality index",
      "unit": "percent",
      "definition": "Median across businesses of (that business's calls in the month ÷ its monthly average), ×100. 100 = an average month. Only businesses with a full 12-month history are included.",
      "event_label": "calls"
    },
    {
      "key": "language_share",
      "label": "Language mix",
      "unit": "percent",
      "definition": "Share of calls with a detected language that were in the given language. Languages used by too few businesses are grouped into 'other'.",
      "event_label": "calls with a detected language"
    }
  ],
  "limitations": [
    "Contributors are Vireek customers who opted in. They are not a random sample of all home service businesses, so figures describe this group only and must not be generalised to an industry or region.",
    "Figures are descriptive. Differences between trades, regions or months are not evidence of cause.",
    "After-hours share uses each business's configured opening hours and time zone; holidays and temporary hours are not modelled, and businesses without both configured are excluded from that metric.",
    "Call answer latency is not recorded per call, so 'speed to answer' is not reported. Speed to first response is measured on leads and only where a first-response time was recorded.",
    "Booking conversion depends on businesses or the AI marking calls as booked and may under-count bookings made outside Vireek.",
    "Average ticket uses invoice amounts on completed jobs; jobs without an invoice are excluded, and amounts are not adjusted for inflation or currency (US businesses, USD only).",
    "Percentages are rounded to whole points, dollar amounts to $25, and counts are rounded. Cells with too few businesses, too few events, or one dominant business are withheld.",
    "Businesses can withdraw consent at any time. Withdrawal applies to future editions; figures already published are aggregates and are not recalculated."
  ],
  "exclusions": [
    "Calls marked as spam.",
    "Businesses that have not opted in, or whose opt-in was withdrawn before the edition was built.",
    "Businesses without a mapped trade or US state are included only in national figures."
  ],
