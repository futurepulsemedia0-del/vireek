{
  "id": "/dashboard",
  "name": "Vireek",
  "short_name": "Vireek",
  "description": "Vireek is an AI voice receptionist and operations dashboard for home service businesses: calls, leads, jobs and your team in one app.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/dashboard?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#FDFCFA",
  "background_color": "#090A0D",
  "categories": ["business", "productivity"],
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/monochrome-512.png", "sizes": "512x512", "type": "image/png", "purpose": "monochrome" }
  ],
  "screenshots": [
    { "src": "/screenshots/wide-dashboard.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Dashboard: calls, leads and jobs at a glance" },
    { "src": "/screenshots/wide-calls.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Every call answered, summarized and logged" },
    { "src": "/screenshots/wide-jobs.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Jobs and dispatch in one place" },
    { "src": "/screenshots/narrow-dashboard.png", "sizes": "720x1280", "type": "image/png", "form_factor": "narrow", "label": "Your day on your phone" },
    { "src": "/screenshots/narrow-calls.png", "sizes": "720x1280", "type": "image/png", "form_factor": "narrow", "label": "Calls and transcripts on the go" },
    { "src": "/screenshots/narrow-jobs.png", "sizes": "720x1280", "type": "image/png", "form_factor": "narrow", "label": "Jobs for the field" }
  ],
  "shortcuts": [
    {
      "name": "Jobs",
      "short_name": "Jobs",
      "url": "/dashboard/jobs?source=shortcut",
      "icons": [{ "src": "/icons/shortcut-jobs-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Calls",
      "short_name": "Calls",
      "url": "/dashboard/calls?source=shortcut",
      "icons": [{ "src": "/icons/shortcut-calls-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Inbox",
      "short_name": "Inbox",
      "url": "/dashboard/inbox?source=shortcut",
      "icons": [{ "src": "/icons/shortcut-inbox-96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ]
}
