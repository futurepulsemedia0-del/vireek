+    expect(makeupDate('2027-05-28', 'next_workday', [1, 2, 3, 4, 5], hol)).toBe('2027-06-01'); // Fri → Mon is Memorial Day → Tue
+    expect(makeupDate('2027-06-07', 'next_workday', [1, 2, 3, 4, 5], hol, new Set(['2027-06-08']))).toBe('2027-06-09');
