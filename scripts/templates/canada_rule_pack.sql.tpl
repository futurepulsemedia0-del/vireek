-- Mirror of validateVersionDraft / validateRuleParams (Canadian branch) in compliance-rules/engine.ts.
CREATE OR REPLACE FUNCTION public.compliance_version_errors(
  p_jurisdiction text, p_kind text, p_severity text, p_applies text[], p_title text, p_explanation text,
  p_params jsonb, p_refs jsonb, p_from date, p_to date
) RETURNS text[] LANGUAGE plpgsql STABLE SET search_path = public AS $$
DECLARE
  e text[];
  v_provinces text[] := ARRAY['AB','BC','MB','NB','NL','NS','NT','NU','ON','PE','QC','SK','YT'];
  w jsonb;
  v_bases text[] := '{}';
  v_basis text;
  v_months numeric;
BEGIN
  IF p_jurisdiction IS NULL OR p_jurisdiction !~ '^CA(-[A-Z]{2})?$' THEN
    RETURN public.compliance_version_errors_nocanada(p_jurisdiction, p_kind, p_severity, p_applies, p_title, p_explanation, p_params, p_refs, p_from, p_to);
  END IF;

  -- Generic and kind-specific checks run through the existing validator with a US stand-in jurisdiction.
  e := public.compliance_version_errors_nocanada('US', p_kind, p_severity, p_applies, p_title, p_explanation, p_params, p_refs, p_from, p_to);

  IF p_jurisdiction <> 'CA' AND NOT (substr(p_jurisdiction, 4) = ANY (v_provinces)) THEN
    e := array_append(e, 'jurisdiction must be CA or CA-<province code>');
  END IF;
  IF p_kind NOT IN ('consent_required', 'quiet_hours', 'required_notice', 'ai_disclosure') THEN
    e := array_append(e, format('%s is not supported for Canadian packs (consent_required, quiet_hours, required_notice, ai_disclosure only)', p_kind));
  END IF;

  IF p_kind = 'consent_required' AND jsonb_typeof(p_params) = 'object' AND p_params ? 'impliedWindows' THEN
    IF jsonb_typeof(p_params -> 'impliedWindows') <> 'array'
       OR jsonb_array_length(p_params -> 'impliedWindows') NOT BETWEEN 1 AND 4 THEN
      e := array_append(e, 'impliedWindows must be a list of up to 2 {basis: transaction | inquiry, months: 1-60} with distinct bases');
    ELSE
      FOR w IN SELECT * FROM jsonb_array_elements(p_params -> 'impliedWindows') LOOP
        v_basis := CASE WHEN jsonb_typeof(w) = 'object' THEN w ->> 'basis' END;
        v_months := CASE WHEN jsonb_typeof(w) = 'object' AND jsonb_typeof(w -> 'months') = 'number' THEN (w ->> 'months')::numeric END;
        IF v_basis IS NULL OR v_basis NOT IN ('transaction', 'inquiry') OR v_basis = ANY (v_bases)
           OR v_months IS NULL OR v_months <> trunc(v_months) OR v_months < 1 OR v_months > 60 THEN
          e := array_append(e, 'impliedWindows must be a list of up to 2 {basis: transaction | inquiry, months: 1-60} with distinct bases');
          EXIT;
        END IF;
        v_bases := array_append(v_bases, v_basis);
      END LOOP;
    END IF;
  END IF;
  RETURN e;
END $$;

