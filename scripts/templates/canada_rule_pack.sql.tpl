-- 3. Seed the Canada pack as 'in_review' --------------------------------------------------------
DO $seed_do$
DECLARE
  r jsonb;
  v_pack uuid;
  v_rule uuid;
  v_ver uuid;
BEGIN
  FOR r IN SELECT * FROM jsonb_array_elements($seed$[
/*@SEED_ROWS@*/
]$seed$::jsonb) LOOP
