 /**
+ * The minutes_included value to write when a billing event reports `newPlanId` for an account that is currently on
+ * `currentPlanId`. `undefined` means "leave the column alone": an account whose plan did NOT change keeps its stored
+ * allowance, so grandfathered legacy minutes survive card updates, trial ends and metadata-only subscription updates.
+ * Only a genuine plan change (or an account with no recorded plan) takes the catalog value.
+ */
+export function minutesToWriteOnSync(
+  currentPlanId: string | null | undefined,
+  newPlanId: string,
+): number | undefined {
+  if (currentPlanId && currentPlanId === newPlanId) return undefined;
+  return minutesForPlan(newPlanId) ?? undefined;
+}
