+export interface InboundDecision {
+  /** Whether the call may be answered by the AI. */
+  allowed: boolean;
+  /** The free minutes ARE exhausted, but enforcement is not on (fraud_settings.enforce <> true): logged, not stopped. */
+  shadowDenied: boolean;
+  allowance: InboundAllowance;
+}
+
+/**
+ * Enforce-or-shadow decision for the free-minute stop. Honours the same fraud_settings.enforce switch as
+ * guardOutbound(), so the stop can be rolled out in log-only mode first. Anything unreadable resolves to "allow":
+ * inbound answering must never break because the fraud store did.
+ */
+export async function evaluateInbound(db: FraudDb, userId: string): Promise<InboundDecision> {
+  const allowance = await checkInboundAllowance(db, userId);
+  if (allowance.allowed) return { allowed: true, shadowDenied: false, allowance };
+  let enforce = false;
+  try {
+    const { data, error } = await db.rpc("fraud_guard_context", { p_user: userId });
+    if (!error && data && typeof data === "object") enforce = (data as { enforce?: unknown }).enforce === true;
+  } catch {
+    /* unknown => shadow */
+  }
+  return enforce ? { allowed: false, shadowDenied: false, allowance } : { allowed: true, shadowDenied: true, allowance };
+}
