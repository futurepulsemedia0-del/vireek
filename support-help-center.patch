+import { FileText } from 'lucide-react';
+import { Link } from 'react-router-dom';
+
+export interface HelpArticleListItem {
+  slug: string;
+  title: string;
+  /** Small label above the title — used in search results to show the category. */
+  eyebrow?: string;
+  /** One-line summary under the title — used in search results. */
+  excerpt?: string;
+}
+
+/**
+ * A list of help articles where every row is a real link to /help/:slug, with a document icon on the
+ * trailing edge. Use it only for article *links* — an expandable (accordion) question should keep a
+ * chevron instead, because a document icon promises navigation to another page.
+ */
+export function HelpArticleList({
+  items,
+  label,
+  className = '',
+}: {
+  items: HelpArticleListItem[];
+  /** Accessible name for the list. */
+  label: string;
+  className?: string;
+}) {
+  return (
+    <ul
+      aria-label={label}
+      className={`divide-y divide-border rounded-2xl border border-border bg-bg-secondary shadow-card dark:shadow-card-dark ${className}`}
+    >
+      {items.map((item) => (
+        <li key={item.slug} className="first:rounded-t-2xl last:rounded-b-2xl">
+          <Link
+            to={`/help/${item.slug}`}
+            className="focus-ring group flex min-h-11 items-center justify-between gap-4 rounded-[inherit] px-4 py-3.5 transition-colors hover:bg-bg-tertiary focus-visible:relative focus-visible:z-10 sm:px-5"
+          >
+            <span className="min-w-0">
+              {item.eyebrow && <span className="block text-xs font-semibold text-accent">{item.eyebrow}</span>}
+              <span className="block text-base font-semibold leading-6 text-text-primary">{item.title}</span>
+              {item.excerpt && (
+                <span className="mt-0.5 line-clamp-2 block text-sm leading-6 text-text-secondary">{item.excerpt}</span>
+              )}
+            </span>
+            <FileText
+              aria-hidden="true"
+              className="icon-md shrink-0 text-text-secondary transition-colors group-hover:text-accent"
+            />
+          </Link>
+        </li>
+      ))}
+    </ul>
+  );
+}
