      "dataClass": "compliance_evidence",
      "steward": "compliance",
      "ownership": "customer",
      "retentionRef": "docs/compliance/data-map.md#1-data-classes",
      "counsel": "Evidence must outlive the calls it proves (data-map D11); retention period is undefined."
    },
    "calls": {
      "dataClass": "personal_sensitive",
      "steward": "voice",
      "ownership": "customer",
      "counsel": "Call audio, transcripts and caller identity are third-party personal data (data-map D1-D4); recording and AI-disclosure duties vary by region."
