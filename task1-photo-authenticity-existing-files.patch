+let wasmReady = false;
+
+/** Compiles the WASM once per isolate, on first use. Any failure degrades to "C2PA unavailable"; metadata checks still run. */
+async function c2pa(): Promise<C2paDeps | null> {
+  try {
+    if (!wasmReady) {
+      // [VERIFY] reading the package asset after Supabase's bundling is untested on the hosted runtime; see docs/photo-provenance.md.
+      const bytes = await Deno.readFile(new URL(import.meta.resolve("npm:@contentauth/c2pa-wasm@0.13.4/c2pa.wasm")));
+      initSync({ module: bytes });
+      wasmReady = true;
+    }
+  } catch (e) {
+    console.error("[photo-provenance] c2pa wasm unavailable", e instanceof Error ? e.message.slice(0, 120) : "unknown");
+    return null;
+  }
+  return {
+    // Public certificates only (not a secret). Unset: signer trust is reported as "not evaluated".
+    trustAnchorsPem: Deno.env.get("C2PA_TRUST_ANCHORS_PEM") ?? null,
+    async readManifestStore(mime, bytes, contextJson) {
+      const reader = await WasmReader.fromBytes(mime, bytes, contextJson);
+      try { return reader.manifestStore(); } finally { reader.free(); }
+    },
+  };
+}
+
+Deno.serve((req: Request) => handlePhotoProvenance(req, { createClient, env: (name) => Deno.env.get(name), c2pa }));
