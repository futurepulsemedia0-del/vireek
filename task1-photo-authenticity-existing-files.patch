+// Pinned, MIT-licensed C2PA reader from the Content Authenticity Initiative. READ-ONLY use: we never sign.
+import { initSync, WasmReader } from "npm:@contentauth/c2pa-wasm@0.13.4";
 import { handlePhotoProvenance } from "../_shared/photo-provenance/handler.ts";
