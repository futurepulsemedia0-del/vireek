# Never commit this file — use .env for real local values.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

VITE_VAPI_PUBLIC_KEY=YOUR_VAPI_PUBLIC_KEY

# Web Push — public VAPID key only
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY

# Google Analytics 4
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry / GlitchTip
VITE_SENTRY_DSN=YOUR_SENTRY_DSN

# Status API
VITE_STATUS_API_URL=https://YOUR-PAGE.instatus.com/summary.json

# Full-app maintenance gate
VITE_MAINTENANCE_MODE=false
VITE_MAINTENANCE_TITLE=Scheduled maintenance
VITE_MAINTENANCE_MESSAGE=We're applying a short update.
# VITE_MAINTENANCE_ETA=2026-09-16T18:30:00Z

# Optional remote JSON to flip maintenance/degraded without redeploy
# VITE_MAINTENANCE_STATUS_URL=https://your-cdn/status-signal.json
