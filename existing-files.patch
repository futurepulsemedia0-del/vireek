+
+// ---------------------------------------------------------------------------------------------------
+// Workflow (mirrors public.warranty_claim_transition_allowed in the database — the DB is authoritative;
+// src/lib/warrantyClaimRecovery.test.ts pins this table so UI and SQL cannot silently drift).
+// ---------------------------------------------------------------------------------------------------
+export const CLAIM_TRANSITIONS: Record<ClaimStatus, ClaimStatus[]> = {
+  needs_review: ['ready', 'expired', 'closed'],
+  eligible: ['needs_review', 'ready', 'expired', 'closed'],
+  packet_pending: ['needs_review', 'ready', 'expired', 'closed'],
+  ready: ['needs_review', 'submitted', 'expired', 'closed'],
+  submitted: ['credit_received', 'denied', 'expired'],
+  approved: ['credit_received', 'denied', 'expired', 'closed'],
+  credit_received: ['closed'],
+  denied: ['closed'],
+  expired: ['closed'],
+  closed: [],
+};
+
+export function canTransition(from: ClaimStatus, to: ClaimStatus): boolean {
+  return CLAIM_TRANSITIONS[from]?.includes(to) ?? false;
+}
+
+export type ClaimAction = 'approve' | 'submit' | 'record_payment' | 'deny' | 'expire' | 'back_to_review' | 'close';
+
+export const CLAIM_ACTION_LABELS: Record<ClaimAction, string> = {
+  approve: 'Approve for submission',
+  submit: 'Mark as submitted',
+  record_payment: 'Record payment',
+  deny: 'Mark denied',
+  expire: 'Mark expired',
+  back_to_review: 'Send back to review',
+  close: 'Close',
+};
+
+// Actions a user can take from a status (payment correction is allowed on an already-paid claim).
+export function availableActions(status: ClaimStatus): ClaimAction[] {
+  const out: ClaimAction[] = [];
+  if (canTransition(status, 'ready')) out.push('approve');
+  if (canTransition(status, 'submitted')) out.push('submit');
+  if (canTransition(status, 'credit_received') || status === 'credit_received') out.push('record_payment');
+  if (canTransition(status, 'denied')) out.push('deny');
+  if (canTransition(status, 'needs_review') && status === 'ready') out.push('back_to_review');
+  if (canTransition(status, 'expired')) out.push('expire');
+  if (canTransition(status, 'closed')) out.push('close');
+  return out;
+}
+
+// ---------------------------------------------------------------------------------------------------
+// Packet (compiled live by public.warranty_claim_packet from recorded data — nothing is invented)
+// ---------------------------------------------------------------------------------------------------
+export type PacketItemKey =
+  | 'manufacturer' | 'model_number' | 'serial_number' | 'install_date' | 'failure_notes'
+  | 'claim_deadline' | 'parts' | 'labor_hours' | 'photos';
+
+export interface PacketItem {
+  key: PacketItemKey;
+  label: string;
+  present: boolean;
+  blocking: boolean;
+}
+
+export interface WarrantyClaimPacket {
+  claim_id: string;
+  status: ClaimStatus;
+  customer_name: string;
+  property_address: string | null;
+  unit: {
+    manufacturer: string | null;
+    model_number: string | null;
+    serial_number: string | null;
+    install_date: string | null;
+    warranty_expires_at: string | null;
+    registration: { registered: boolean; purchase_date?: string | null; install_date?: string | null; registered_on?: string | null };
+  };
+  job: { id: string | null; completed_at: string | null; service_type: string | null };
+  failure_notes: { text: string | null; source: 'claim' | 'job_outcome' | 'job_notes' | null };
+  parts: { name: string; part_number: string | null; quantity: number; unit_cost_cents: number | null }[];
+  labor: { hours: number | null; entries: number; source: string };
+  photos: { id: string; kind: string | null; caption: string | null; file_name: string | null; taken_at: string | null }[];
+  claim_deadline: string | null;
+  detection_basis: Record<string, unknown> | null;
+  checklist: PacketChecklist | null;
+  items: PacketItem[];
+  missing: PacketItemKey[];
+  blocking_missing: PacketItemKey[];
+  complete: boolean;
+}
+
+// Maps database error codes (RAISE EXCEPTION text) to plain-language messages.
+export function warrantyErrorMessage(raw: string | null | undefined): string {
+  const m = raw ?? '';
+  if (m.includes('WARRANTY_PACKET_INCOMPLETE')) {
+    const keys = (m.split('WARRANTY_PACKET_INCOMPLETE:')[1] ?? '').split(',').map((k) => k.trim()).filter(Boolean);
+    return keys.length ? `Packet is missing required items: ${keys.join(', ').replace(/_/g, ' ')}.` : 'Packet is missing required items.';
+  }
+  if (m.includes('WARRANTY_HUMAN_APPROVAL_REQUIRED')) return 'Please confirm the approval to continue.';
+  if (m.includes('WARRANTY_REF_REQUIRED')) return 'Enter the manufacturer reference / claim number you received.';
+  if (m.includes('WARRANTY_REF_TOO_LONG')) return 'Reference number is too long (120 characters max).';
+  if (m.includes('WARRANTY_AMOUNT_INVALID')) return 'Enter an amount greater than $0.';
+  if (m.includes('WARRANTY_DATE_IN_FUTURE')) return 'The payment date cannot be in the future.';
+  if (m.includes('WARRANTY_INVALID_TRANSITION')) return 'That status change is not allowed from the current status.';
+  if (m.includes('WARRANTY_FORBIDDEN')) return 'You do not have permission to manage warranty claims.';
+  if (m.includes('WARRANTY_CLAIM_NOT_FOUND')) return 'Claim not found.';
+  if (m.includes('WARRANTY_STATUS_VIA_RPC_ONLY') || m.includes('WARRANTY_PROTECTED_FIELDS')) return 'Use the claim actions to change status or payment.';
+  return 'Something went wrong. Please try again.';
+}
+
+// Parse a dollar string ("1,250.50") to whole cents; null when invalid or not > 0.
+export function dollarsToCents(input: string): number | null {
+  const cleaned = input.replace(/[$,\s]/g, '');
+  if (!/^\d+(\.\d{1,2})?$/.test(cleaned)) return null;
+  const cents = Math.round(Number(cleaned) * 100);
+  return cents > 0 && cents <= 2_147_483_647 ? cents : null;
+}
