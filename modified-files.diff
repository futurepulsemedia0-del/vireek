+
+// ---------------------------------------------------------------------------
+// Canada. Jurisdiction codes: "CA" (federal) and "CA-XX" (province / territory). "US-CA" is California;
+// the two can never be confused because the country prefix is always checked first.
+// [COUNSEL][VERIFY] Province list and area-code table below are engineering inputs, not legal advice.
+// ---------------------------------------------------------------------------
+
+export const CA_PROVINCES: ReadonlySet<string> = new Set(
+  "AB BC MB NB NL NS NT NU ON PE QC SK YT".split(" "),
+);
+
+export type Country = "US" | "CA";
+
+/** "US" | "US-TX" -> "US"; "CA" | "CA-ON" -> "CA"; anything else -> null. */
+export function jurisdictionCountry(code: string | null | undefined): Country | null {
+  if (!code) return null;
+  if (/^US(-[A-Z]{2})?$/.test(code)) return "US";
+  if (/^CA(-[A-Z]{2})?$/.test(code)) return "CA";
+  return null;
+}
+
+/** "ON", " on ", "CA-ON" -> "ON"; anything else -> null. */
+export function normalizeProvince(v: string | null | undefined): string | null {
+  if (!v) return null;
+  const s = v.trim().toUpperCase().replace(/^CA-/, "");
+  return CA_PROVINCES.has(s) ? s : null;
+}
+
+/** "CA" -> null (federal); "CA-ON" -> "ON"; US codes -> null. */
+export function provinceOfJurisdiction(code: string): string | null {
+  return jurisdictionCountry(code) === "CA" && code !== "CA" ? normalizeProvince(code) : null;
+}
