+-- user_flag_is_on(): the server-side check edge functions use for the product-surface freeze.
+-- Run with:  supabase test db
+begin;
+create extension if not exists pgtap with schema extensions;
+select plan(10);
+
+insert into auth.users (id, email) values
+  ('00000000-0000-0000-0000-0000000000a1', 'owner-a@gate.test'),
+  ('00000000-0000-0000-0000-0000000000a2', 'member-a@gate.test'),
+  ('00000000-0000-0000-0000-0000000000b1', 'owner-b@gate.test');
+-- a2 is a team member of account a1 (resolved by email, like get_account_owner_id())
+delete from public.profiles where id = '00000000-0000-0000-0000-0000000000a2';
+insert into public.team_members (account_owner_id, member_email, role)
+  values ('00000000-0000-0000-0000-0000000000a1', 'member-a@gate.test', 'member');
+
+-- default: nobody has the flag
+select is(public.user_flag_is_on('00000000-0000-0000-0000-0000000000a1', 'experimental_surface'), false, 'new owner: off by default');
+select is(public.user_flag_is_on('00000000-0000-0000-0000-0000000000a2', 'experimental_surface'), false, 'new team member: off by default');
+
+-- fail closed
+select is(public.user_flag_is_on('00000000-0000-0000-0000-00000000dead', 'experimental_surface'), false, 'unknown user: false');
+select is(public.user_flag_is_on('00000000-0000-0000-0000-0000000000a1', 'no_such_flag'), false, 'unknown flag: false');
+select is(public.user_flag_is_on(null, 'experimental_surface'), false, 'null user: false');
+
+-- override on for account A
+insert into public.feature_flag_overrides (flag_id, tenant_id, state)
+  select id, '00000000-0000-0000-0000-0000000000a1', 'on' from public.feature_flags where key = 'experimental_surface';
+select is(public.user_flag_is_on('00000000-0000-0000-0000-0000000000a1', 'experimental_surface'), true, 'owner with override: on');
+select is(public.user_flag_is_on('00000000-0000-0000-0000-0000000000a2', 'experimental_surface'), true, 'team member inherits the account owner flag');
+select is(public.user_flag_is_on('00000000-0000-0000-0000-0000000000b1', 'experimental_surface'), false, 'other account unaffected');
+
+-- master switch is a kill switch even with an override
+update public.feature_flags set enabled = false where key = 'experimental_surface';
+select is(public.user_flag_is_on('00000000-0000-0000-0000-0000000000a1', 'experimental_surface'), false, 'master switch off beats the override');
+
+-- not callable by tenants
+select set_config('role', 'authenticated', true);
+select throws_ok($$ select public.user_flag_is_on('00000000-0000-0000-0000-0000000000a1', 'experimental_surface') $$, '42501', null,
+  'authenticated users cannot call user_flag_is_on');
+
+select * from finish();
+rollback;
