+-- Product-surface freeze: `experimental_surface` / `full_navigation` are OFF for new tenants,
+-- existing tenants are grandfathered ON, only staff can change a tenant, tenants cannot forge it (pgTAP).
+-- Run with:  supabase test db
+begin;
+create extension if not exists pgtap with schema extensions;
+select plan(17);
+
+-- ---------------------------------------------------------------- fixtures --
+-- handle_new_user() creates a profile (role defaults to 'owner') for each auth user.
+insert into auth.users (id, email) values
+  ('00000000-0000-0000-0000-0000000000a1', 'tenant-a@surface.test'),
+  ('00000000-0000-0000-0000-0000000000b1', 'tenant-b@surface.test'),
+  ('00000000-0000-0000-0000-0000000000f1', 'staff@surface.test');
+update public.profiles set is_staff = true where id = '00000000-0000-0000-0000-0000000000f1';
+
+-- C is an EXISTING tenant (created before the freeze cutoff); A and B are NEW tenants.
+insert into auth.users (id, email) values ('00000000-0000-0000-0000-0000000000c1', 'tenant-c@surface.test');
+update public.profiles set created_at = now() - interval '30 days' where id = '00000000-0000-0000-0000-0000000000c1';
+
+create or replace function pg_temp.act_as(p_user uuid) returns void language plpgsql as $$
+begin
+  perform set_config('role', 'authenticated', true);
+  perform set_config('request.jwt.claim.sub', p_user::text, true);
+  perform set_config('request.jwt.claims', json_build_object('sub', p_user, 'role', 'authenticated')::text, true);
+end $$;
+
+-- ------------------------------------------------------------- seeded row --
+select is((select count(*)::int from public.feature_flags where key = 'experimental_surface'), 1,
+  'migration seeded the experimental_surface flag');
+select ok((select bool_and(enabled and rollout_pct = 0) from public.feature_flags where key in ('experimental_surface', 'full_navigation')),
+  'both flags seeded as overrides-only (enabled, 0% rollout)');
+select is((select count(*)::int from public.feature_flags where key = 'full_navigation'), 1, 'migration seeded the full_navigation flag');
+
+-- ------------------------------------------------ grandfathering (existing C) --
+reset role;
+select ok(public.surface_grandfather_existing_tenants(now() - interval '1 day') >= 2,
+  'grandfathering gives the existing tenant both overrides');
+select is(public.surface_grandfather_existing_tenants(now() - interval '1 day'), 0, 'grandfathering is idempotent');
+select pg_temp.act_as('00000000-0000-0000-0000-0000000000c1');
+select is((select count(*)::int from public.get_my_feature_flags() where flag_key in ('experimental_surface', 'full_navigation')), 2,
+  'an existing tenant keeps the full surface');
+reset role;
+
+-- ------------------------------------------------- default: OFF for tenants --
+select pg_temp.act_as('00000000-0000-0000-0000-0000000000a1');
+select ok(not exists (select 1 from public.get_my_feature_flags() where flag_key in ('experimental_surface', 'full_navigation')),
+  'a new tenant gets neither experimental_surface nor full_navigation (Core nav only)');
+select throws_ok($$ select public.surface_grandfather_existing_tenants(now()) $$, '42501', null,
+  'a tenant cannot run the grandfather function');
+
+-- tenants cannot forge it
+select throws_ok($$ insert into public.feature_flag_overrides (flag_id, tenant_id, state)
+  select id, '00000000-0000-0000-0000-0000000000a1', 'on' from public.feature_flags where key = 'experimental_surface' $$,
+  '42501', null, 'a tenant cannot write overrides directly');
+select throws_ok($$ select public.staff_set_flag_override(
+  (select id from public.feature_flags where key = 'experimental_surface'), '00000000-0000-0000-0000-0000000000a1', 'on', null) $$,
+  '42501', null, 'a tenant cannot call the staff override RPC');
+select is((with u as (update public.feature_flags set rollout_pct = 100 where key = 'experimental_surface' returning 1) select count(*)::int from u), 0,
+  'a tenant cannot change the flag itself');
+select is((select count(*)::int from public.feature_flags), 0, 'a tenant cannot even read the flag table (staff only)');
+
+-- ----------------------------------------------- staff override: on, scoped --
+select pg_temp.act_as('00000000-0000-0000-0000-0000000000f1');
+select lives_ok($$ select public.staff_set_flag_override(
+  (select id from public.feature_flags where key = 'experimental_surface'), '00000000-0000-0000-0000-0000000000a1', 'on', 'pilot demo') $$,
+  'staff can enable the flag for one tenant');
+
+select pg_temp.act_as('00000000-0000-0000-0000-0000000000a1');
+select ok(exists (select 1 from public.get_my_feature_flags() where flag_key = 'experimental_surface'),
+  'that tenant now gets experimental_surface');
+
+select pg_temp.act_as('00000000-0000-0000-0000-0000000000b1');
+select ok(not exists (select 1 from public.get_my_feature_flags() where flag_key = 'experimental_surface'),
+  'another tenant is unaffected (no cross-tenant leakage)');
+
+-- -------------------------------------------------------------- audit trail --
+reset role;
+select is((select count(*)::int from public.feature_flag_audit
+            where flag_key = 'experimental_surface' and action = 'override_set'
+              and tenant_id = '00000000-0000-0000-0000-0000000000a1'), 1,
+  'the override is recorded in feature_flag_audit');
+
+-- master switch off => off even with an override
+update public.feature_flags set enabled = false where key = 'experimental_surface';
+select pg_temp.act_as('00000000-0000-0000-0000-0000000000a1');
+select ok(not exists (select 1 from public.get_my_feature_flags() where flag_key = 'experimental_surface'),
+  'master switch off overrides the tenant override (kill switch)');
+
+select * from finish();
+rollback;
