+  L.push('## Summary');
+  L.push('');
+  L.push(`Page modules under \`src/pages\` (excluding tests): **${pages.length}** · routed: **${pages.filter((p) => p.routes.length).length}** · in dashboard nav: **${pages.filter((p) => p.nav).length}** · page test files: **${inv.pageTestFiles}** · e2e specs: **${inv.e2eFiles.length}**`);
