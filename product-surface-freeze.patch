+      console.error('docs/product-surface.md is stale. Run: npm run docs:surface');
+      process.exit(1);
+    }
+    const errors = reviewFlags(buildInventory(root)).filter((f) => f.level === 'error');
+    if (errors.length) {
+      for (const e of errors) console.error(`error: ${e.msg}`);
+      process.exit(1);
+    }
+    console.log('docs/product-surface.md is up to date and has no error-level review flags.');
+  } else {
+    writeFileSync(out, md);
+    console.log(`wrote ${posix(relative(root, out))} (${md.length} bytes)`);
+  }
+}
