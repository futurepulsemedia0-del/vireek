@@ -0,0 +1,39 @@
+// Server-side half of the pilot product-surface freeze (see docs/product-surface.md).
+// Unverified features are hidden in the UI; this makes their backends refuse tenants that
+// do not have the `experimental_surface` flag. FAIL CLOSED: any lookup error => not allowed.
+import type { SupabaseClient } from "npm:@supabase/supabase-js@2.57.4";
+
+export const EXPERIMENTAL_SURFACE_FLAG = "experimental_surface";
+
+/** `admin` must be a service-role client (user_flag_is_on is service_role only). */
+export async function userHasFlag(
+  admin: Pick<SupabaseClient, "rpc">,
+  userId: string,
+  key: string = EXPERIMENTAL_SURFACE_FLAG,
+): Promise<boolean> {
+  if (!userId) return false;
+  try {
+    const { data, error } = await admin.rpc("user_flag_is_on", { p_user: userId, p_key: key });
+    return !error && data === true;
+  } catch {
+    return false;
+  }
+}
+
+export function featureNotEnabledResponse(headers: Record<string, string>): Response {
+  return new Response(
+    JSON.stringify({ error: "This feature is not enabled for your account.", code: "feature_not_enabled" }),
+    { status: 403, headers: { ...headers, "Content-Type": "application/json" } },
+  );
+}
+
+/** Constant-time string compare (for shared secrets). Returns false on any missing input. */
+export function secretsMatch(provided: string | null | undefined, expected: string | null | undefined): boolean {
+  if (!provided || !expected) return false;
+  const a = new TextEncoder().encode(provided);
+  const b = new TextEncoder().encode(expected);
+  let diff = a.length ^ b.length;
+  const n = Math.max(a.length, b.length);
+  for (let i = 0; i < n; i++) diff |= (a[i] ?? 0) ^ (b[i] ?? 0);
+  return diff === 0;
+}
