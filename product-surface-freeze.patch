+  const more = ok.length > 5 ? ` +${ok.length - 5}` : '';
+  const miss = p.missing.length ? ` ⚠ unresolved: ${p.missing.slice(0, 3).map(tag).join(', ')}${p.missing.length > 3 ? ` +${p.missing.length - 3}` : ''}` : '';
