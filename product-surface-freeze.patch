diff -ruN -x node_modules -x .git a/e2e/product-surface.spec.ts b/e2e/product-surface.spec.ts
--- a/e2e/product-surface.spec.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/e2e/product-surface.spec.ts	2026-10-29 11:11:10.125976192 +0000
@@ -0,0 +1,101 @@
+// e2e/product-surface.spec.ts
+//
+// Smoke for the pilot product-surface freeze (docs/product-surface.md).
+//
+//  1. Signed-out (needs no secrets): gated and core dashboard URLs still bounce to /login — no
+//     5xx, no blank page, no redirect loop caused by the ExperimentalSurfaceGuard.
+//  2. NEW tenant (needs a staging account created AFTER migration 20271231130000, i.e. without
+//     grandfathered flag overrides):
+//       E2E_NEW_TENANT_EMAIL / E2E_NEW_TENANT_PASSWORD
+//     - the dashboard nav lists Core entries only,
+//     - every unverified URL redirects to /dashboard (no crash),
+//     - every nav link resolves to a real page (not the 404 route) and does not hit the error boundary.
+//
+// These need a built app + (for 2) a real staging backend, so they are skipped when the
+// secrets are absent. Never point them at production.
+import { test, expect } from '@playwright/test';
+import { readFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+
+interface Entry { path: string; exact?: boolean }
+const manifest = JSON.parse(
+  readFileSync(fileURLToPath(new URL('../src/lib/productSurface.manifest.json', import.meta.url)), 'utf8'),
+) as { core: Entry[]; unverified: Entry[] };
+
+const norm = (p: string) => decodeURIComponent(p.split('?')[0].split('#')[0]).toLowerCase().replace(/\/{2,}/g, '/').replace(/(.)\/$/, '$1');
+const hit = (list: Entry[], p: string) =>
+  list.filter((e) => p === e.path || (!e.exact && p.startsWith(`${e.path}/`))).sort((a, b) => b.path.length - a.path.length)[0];
+const isCore = (href: string) => {
+  const p = norm(href);
+  const c = hit(manifest.core, p);
+  const u = hit(manifest.unverified, p);
+  return !!c && (!u || c.path.length >= u.path.length);
+};
+
+const NOT_FOUND = /This call didn.t go through/;
+const CRASH = /Something went wrong/;
+
+test.describe('Surface freeze — signed out', () => {
+  const samples = [
+    ...manifest.unverified.slice(0, 6).map((e) => e.path),
+    '/dashboard/jobs',
+    '/dashboard/customers',
+    '/dashboard/invoicing',
+    '/dashboard/integrations',
+    '/dashboard/warranty-claims',
+  ];
+  for (const path of samples) {
+    test(`${path} → /login without an error`, async ({ page }) => {
+      const res = await page.goto(path);
+      expect(res?.status() ?? 200).toBeLessThan(500);
+      await page.waitForURL(/\/login/);
+      await expect(page.locator('body')).not.toBeEmpty();
+      await expect(page.locator('body')).not.toContainText(CRASH);
+    });
+  }
+});
+
+const EMAIL = process.env.E2E_NEW_TENANT_EMAIL;
+const PASSWORD = process.env.E2E_NEW_TENANT_PASSWORD;
+
+test.describe('Surface freeze — new tenant', () => {
+  test.skip(!EMAIL || !PASSWORD, 'E2E_NEW_TENANT_EMAIL / E2E_NEW_TENANT_PASSWORD not set — skipping.');
+
+  test.beforeEach(async ({ page }) => {
+    await page.goto('/login');
+    await page.getByLabel('Email address').fill(EMAIL!);
+    await page.getByLabel('Password').fill(PASSWORD!);
+    await page.getByRole('button', { name: 'Sign In' }).click();
+    await page.waitForURL(/\/dashboard/);
+  });
+
+  test('nav lists Core entries only', async ({ page }) => {
+    await page.goto('/dashboard');
+    const nav = page.getByRole('navigation', { name: 'Main navigation' });
+    await expect(nav).toBeVisible();
+    await expect.poll(async () => (await nav.locator('a[href^="/"]').count())).toBeGreaterThan(0);
+    const hrefs = await nav.locator('a[href^="/"]').evaluateAll((as) => as.map((a) => a.getAttribute('href') as string));
+    const offenders = hrefs.filter((h) => !isCore(h));
+    expect(offenders, `non-Core nav entries visible to a new tenant: ${offenders.join(', ')}`).toEqual([]);
+  });
+
+  test('every unverified URL redirects to /dashboard instead of rendering or crashing', async ({ page }) => {
+    for (const e of manifest.unverified) {
+      await page.goto(e.path);
+      await page.waitForURL((u) => u.pathname === '/dashboard');
+      await expect(page.locator('body')).not.toContainText(CRASH);
+    }
+  });
+
+  test('every visible nav link resolves to a real page', async ({ page }) => {
+    await page.goto('/dashboard');
+    const nav = page.getByRole('navigation', { name: 'Main navigation' });
+    const hrefs = [...new Set(await nav.locator('a[href^="/"]').evaluateAll((as) => as.map((a) => a.getAttribute('href') as string)))];
+    expect(hrefs.length).toBeGreaterThan(0);
+    for (const h of hrefs) {
+      await page.goto(h);
+      await expect(page.locator('body'), `${h} rendered the 404 route`).not.toContainText(NOT_FOUND);
+      await expect(page.locator('body'), `${h} hit the error boundary`).not.toContainText(CRASH);
+    }
+  });
+});
