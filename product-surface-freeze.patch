+
+type Rpc = (fn: string, args: Record<string, unknown>) => Promise<{ data: unknown; error: unknown }>;
+const client = (rpc: Rpc) => ({ rpc }) as unknown as Parameters<typeof userHasFlag>[0];
+
+describe("userHasFlag (fails closed)", () => {
+  it("is true only when the RPC returns exactly true", async () => {
+    const calls: Array<[string, Record<string, unknown>]> = [];
+    const c = client(async (fn, args) => { calls.push([fn, args]); return { data: true, error: null }; });
+    expect(await userHasFlag(c, "u1")).toBe(true);
+    expect(calls[0][0]).toBe("user_flag_is_on");
+    expect(calls[0][1]).toEqual({ p_user: "u1", p_key: EXPERIMENTAL_SURFACE_FLAG });
+  });
+  it("is false for false, null, truthy non-booleans and RPC errors", async () => {
+    for (const r of [{ data: false, error: null }, { data: null, error: null }, { data: "true", error: null }, { data: 1, error: null }, { data: true, error: { message: "boom" } }]) {
+      expect(await userHasFlag(client(async () => r), "u1")).toBe(false);
+    }
+  });
+  it("is false when the RPC throws", async () => {
+    expect(await userHasFlag(client(async () => { throw new Error("network"); }), "u1")).toBe(false);
+  });
+  it("is false without calling the RPC for an empty user id", async () => {
+    let called = false;
+    expect(await userHasFlag(client(async () => { called = true; return { data: true, error: null }; }), "")).toBe(false);
+    expect(called).toBe(false);
+  });
+  it("passes a custom flag key through", async () => {
+    let key = "";
+    await userHasFlag(client(async (_f, a) => { key = String(a.p_key); return { data: true, error: null }; }), "u1", "full_navigation");
+    expect(key).toBe("full_navigation");
+  });
+});
+
+describe("featureNotEnabledResponse", () => {
+  it("is a 403 JSON response with a stable code and keeps CORS headers", async () => {
+    const r = featureNotEnabledResponse({ "Access-Control-Allow-Origin": "*" });
+    expect(r.status).toBe(403);
+    expect(r.headers.get("Access-Control-Allow-Origin")).toBe("*");
+    expect(r.headers.get("Content-Type")).toBe("application/json");
+    expect((await r.json()).code).toBe("feature_not_enabled");
+  });
+});
+
+describe("secretsMatch", () => {
+  it("matches equal secrets only", () => {
+    expect(secretsMatch("abc123", "abc123")).toBe(true);
+    expect(secretsMatch("abc123", "abc124")).toBe(false);
+    expect(secretsMatch("abc", "abc123")).toBe(false);
+  });
+  it("never matches when either side is missing (unset CRON_SECRET must not open the door)", () => {
+    expect(secretsMatch(undefined, undefined)).toBe(false);
+    expect(secretsMatch("", "")).toBe(false);
+    expect(secretsMatch(null, "x")).toBe(false);
+    expect(secretsMatch("x", undefined)).toBe(false);
+  });
+});
+
+// Source assertions: the gate must stay wired. (The generator's --check also enforces this for
+// every function behind an unverified page.)
+const fnSrc = (n: string) => readFileSync(resolve(__dirname, "..", n, "index.ts"), "utf8");
+describe("wiring", () => {
+  const gated = [
+    "business-decision-engine", "business-drift-scan", "business-scientist-cycle", "cash-flow-war-room",
+    "causal-shock-simulator", "causal-world-simulator", "identity-signal-scan", "opportunity-cost-scan",
+    "workforce-equilibrium-engine", "outcome-benchmark-advisor", "switching-shield", "flywheel-engine",
+  ];
+  for (const n of gated) {
+    it(`${n} refuses tenants without the flag`, () => {
+      expect(fnSrc(n)).toContain("userHasFlag(");
+    });
+  }
+  it("flywheel-engine authenticates (cron secret or user JWT) before using the service role", () => {
+    const s = fnSrc("flywheel-engine");
+    expect(s).toContain("secretsMatch(");
+    expect(s).toContain("auth.getUser()");
+    expect(s.indexOf("auth.getUser()")).toBeLessThan(s.indexOf("promoteMemoryEntries(admin, userId)"));
+  });
+  it("user_flag_is_on is service_role only in the migration", () => {
+    const sql = readFileSync(resolve(__dirname, "../../migrations/20271231140000_surface_flag_server_check.sql"), "utf8");
+    expect(sql).toContain("REVOKE ALL ON FUNCTION public.user_flag_is_on(uuid, text) FROM PUBLIC, anon, authenticated;");
