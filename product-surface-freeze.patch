+  L.push('');
+  L.push('## Review flags');
+  L.push('');
+  if (flags.length === 0) L.push('None.');
+  for (const f of flags) L.push(`- **${f.level}** — ${f.msg}`);
+  L.push('');
+  for (const t of ['core', 'unverified', 'secondary']) {
+    L.push(`## ${TIER_LABEL[t]} pages (${count(t)})`);
+    L.push('');
+    L.push('| Page | Route(s) | Nav | Backend | Tests |');
+    L.push('|---|---|:-:|---|---|');
+    for (const p of by(t)) {
+      L.push(`| \`${p.module}\` | ${p.routes.length ? p.routes.map((r) => `\`${esc(r)}\``).join('<br>') : '—'} | ${p.nav ? 'Y' : ''} | ${esc(backendCell(p))} | ${testsCell(p)} |`);
