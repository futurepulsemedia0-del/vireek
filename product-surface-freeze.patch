diff -ruN -x node_modules -x .git a/supabase/migrations/20271231130000_product_surface_freeze_flag.sql b/supabase/migrations/20271231130000_product_surface_freeze_flag.sql
--- a/supabase/migrations/20271231130000_product_surface_freeze_flag.sql	1970-01-01 00:00:00.000000000 +0000
+++ b/supabase/migrations/20271231130000_product_surface_freeze_flag.sql	2026-10-29 11:11:12.131514680 +0000
@@ -0,0 +1,62 @@
+/*
+  # Pilot product-surface freeze: seed two feature flags and grandfather existing tenants
+
+  Reuses the existing feature-flag system (20270411000100_feature_flags.sql). No new tables,
+  columns or policies. Nothing is deleted or altered.
+
+  Flags (both seeded enabled = true, rollout_pct = 0 => "overrides only": OFF unless a tenant
+  has an 'on' override)
+    experimental_surface  unverified/abstract pages: nav entry AND route (src/lib/productSurface.manifest.json)
+    full_navigation       secondary pages appear in the dashboard nav (routes always work)
+
+  New tenants (profiles created after this migration) therefore get the Core nav only.
+  Existing owner tenants are grandfathered ON for both flags, so nobody already using the
+  product loses anything. Staff can change any tenant at /staff/feature-flags.
+
+  Fail-closed: if a flag row is missing or the lookup fails, the client hides the gated surface.
+  Idempotent: flags use ON CONFLICT DO NOTHING; grandfathering skips existing overrides
+  (an explicit 'off' override is never replaced). Every override is audited by the existing
+  feature_flag_overrides_audit trigger.
+
+  Rollback (UI freeze only):
+    - show everything to everyone:  UPDATE feature_flags SET rollout_pct = 100 WHERE key IN ('experimental_surface','full_navigation');
+    - take a tenant out of the grandfather group: staff set that tenant's override to 'off' (or inherit).
+*/
+
+INSERT INTO public.feature_flags (key, name, description, enabled, rollout_pct) VALUES
+  ('experimental_surface', 'Experimental / unverified pages',
+   'Shows the unverified (abstract/experimental) dashboard pages listed in docs/product-surface.md. OFF by default; enable per tenant with an override.',
+   true, 0),
+  ('full_navigation', 'Full dashboard navigation',
+   'Lists Secondary pages in the dashboard nav. When OFF a tenant sees the Core nav only (routes still work). OFF by default; enable per tenant with an override.',
+   true, 0)
+ON CONFLICT (key) DO NOTHING;
+
+-- Grandfather tenants that existed before the freeze. p_created_before bounds the group so a
+-- later re-run can never un-freeze tenants created after the cutoff it is given.
+CREATE OR REPLACE FUNCTION public.surface_grandfather_existing_tenants(p_created_before timestamptz)
+RETURNS integer
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = public
+AS $$
+DECLARE
+  v_n integer;
+BEGIN
+  INSERT INTO feature_flag_overrides (flag_id, tenant_id, state, note)
+  SELECT f.id, p.id, 'on', 'grandfathered at product-surface freeze'
+    FROM feature_flags f
+   CROSS JOIN profiles p
+   WHERE f.key IN ('experimental_surface', 'full_navigation')
+     AND p.role = 'owner'
+     AND p.created_at < p_created_before
+  ON CONFLICT (flag_id, tenant_id) DO NOTHING;
+  GET DIAGNOSTICS v_n = ROW_COUNT;
+  RETURN v_n;
+END;
+$$;
+
+REVOKE ALL ON FUNCTION public.surface_grandfather_existing_tenants(timestamptz) FROM PUBLIC, anon, authenticated;
+GRANT EXECUTE ON FUNCTION public.surface_grandfather_existing_tenants(timestamptz) TO service_role;
+
+SELECT public.surface_grandfather_existing_tenants(now());
