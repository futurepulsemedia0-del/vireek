+  L.push('');
+  L.push(`Backend universe found in the repo: ${inv.known.tables} tables/views, ${inv.known.rpcs} SQL functions, ${inv.known.edge} edge-function folders.`);
+  L.push('');
+  L.push('## Gating');
+  L.push('');
+  L.push(`Two flags on the existing \`feature_flags\` mechanism (both seeded OFF = "overrides only"; see \`supabase/migrations/20271231130000_product_surface_freeze_flag.sql\`):`);
+  L.push('');
+  L.push('| Flag | Controls | New tenant | Existing tenants |');
+  L.push('|---|---|---|---|');
