@@ -0,0 +1,96 @@
+import '@testing-library/jest-dom/vitest';
+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
+import { render, screen, act } from '@testing-library/react';
+import { MemoryRouter, Route, Routes } from 'react-router-dom';
+import { ExperimentalSurfaceGuard, FLAG_WAIT_MS } from './ExperimentalSurfaceGuard';
+
+const auth = { user: { id: 'u1' } as { id: string } | null, loading: false };
+const flags = { ready: true, enabled: false };
+const toast = vi.fn();
+
+vi.mock('@/contexts/AuthContext', () => ({ useAuth: () => auth }));
+vi.mock('@/contexts/ToastContext', () => ({ useToast: () => ({ toast }) }));
+vi.mock('@/hooks/useFeatureFlag', () => ({
+  useFeatureFlags: () => ({ ready: flags.ready, isEnabled: () => flags.enabled }),
+}));
+vi.mock('@/components/RouteLoader', () => ({ RouteLoader: () => <div>loading</div> }));
+
+function renderAt(path: string) {
+  return render(
+    <MemoryRouter initialEntries={[path]}>
+      <ExperimentalSurfaceGuard>
+        <Routes>
+          <Route path="/dashboard" element={<div>Overview page</div>} />
+          <Route path="/dashboard/jobs" element={<div>Jobs page</div>} />
+          <Route path="/dashboard/entropy" element={<div>Entropy page</div>} />
+          <Route path="/login" element={<div>Login page</div>} />
+        </Routes>
+      </ExperimentalSurfaceGuard>
+    </MemoryRouter>,
+  );
+}
+
+beforeEach(() => {
+  auth.user = { id: 'u1' };
+  auth.loading = false;
+  flags.ready = true;
+  flags.enabled = false;
+  toast.mockClear();
+});
+afterEach(() => vi.useRealTimers());
+
+describe('ExperimentalSurfaceGuard', () => {
+  it('redirects an unverified route to /dashboard (with a toast) when the flag is off', () => {
+    renderAt('/dashboard/entropy');
+    expect(screen.getByText('Overview page')).toBeInTheDocument();
+    expect(screen.queryByText('Entropy page')).not.toBeInTheDocument();
+    expect(toast).toHaveBeenCalledTimes(1);
+  });
+
+  it('is case-insensitive like the router', () => {
+    renderAt('/Dashboard/Entropy/');
+    expect(screen.queryByText('Entropy page')).not.toBeInTheDocument();
+  });
+
+  it('renders the unverified route when the tenant has the flag', () => {
+    flags.enabled = true;
+    renderAt('/dashboard/entropy');
+    expect(screen.getByText('Entropy page')).toBeInTheDocument();
+    expect(toast).not.toHaveBeenCalled();
+  });
+
+  it('shows a loader, not the page and not a redirect, while flags load', () => {
+    flags.ready = false;
+    renderAt('/dashboard/entropy');
+    expect(screen.getByText('loading')).toBeInTheDocument();
+    expect(screen.queryByText('Entropy page')).not.toBeInTheDocument();
+    expect(screen.queryByText('Overview page')).not.toBeInTheDocument();
+  });
+
+  it('fails closed (redirects) if flags never resolve', () => {
+    vi.useFakeTimers();
+    flags.ready = false;
+    renderAt('/dashboard/entropy');
+    act(() => { vi.advanceTimersByTime(FLAG_WAIT_MS + 50); });
+    expect(screen.getByText('Overview page')).toBeInTheDocument();
+  });
+
+  it('never touches Core/Secondary routes, even while flags are loading or broken', () => {
+    flags.ready = false;
+    renderAt('/dashboard/jobs');
+    expect(screen.getByText('Jobs page')).toBeInTheDocument();
+  });
+
+  it('lets signed-out visitors through so ProtectedRoute can send them to /login', () => {
+    auth.user = null;
+    renderAt('/dashboard/entropy');
+    expect(screen.getByText('Entropy page')).toBeInTheDocument();
+  });
+
+  it('waits for auth before deciding', () => {
+    auth.user = null;
+    auth.loading = true;
+    renderAt('/dashboard/entropy');
+    expect(screen.getByText('loading')).toBeInTheDocument();
+  });
+});
diff -ruN -x node_modules -x .git a/src/components/ExperimentalSurfaceGuard.tsx b/src/components/ExperimentalSurfaceGuard.tsx
--- a/src/components/ExperimentalSurfaceGuard.tsx	1970-01-01 00:00:00.000000000 +0000
+++ b/src/components/ExperimentalSurfaceGuard.tsx	2026-10-29 11:11:11.605198396 +0000
@@ -0,0 +1,55 @@
+import { ReactNode, useEffect, useRef, useState } from 'react';
+import { Navigate, useLocation } from 'react-router-dom';
+import { useAuth } from '@/contexts/AuthContext';
+import { useToast } from '@/contexts/ToastContext';
+import { useFeatureFlags } from '@/hooks/useFeatureFlag';
+import { EXPERIMENTAL_SURFACE_FLAG, isUnverifiedPath } from '@/lib/productSurface';
+import { RouteLoader } from '@/components/RouteLoader';
+
+/** If the flag lookup has not resolved by then, fail closed (treat as OFF). */
+export const FLAG_WAIT_MS = 4000;
+
+/**
+ * Wraps <Routes>. For paths in the manifest's `unverified` tier it renders the route only when
+ * the signed-in tenant has the `experimental_surface` flag; otherwise it redirects to
+ * /dashboard with a toast. Every other path passes straight through, so Core/Secondary routes
+ * are never affected by flag state or flag-service failures.
+ *
+ * - Signed-out visitors pass through: the unverified routes are all <ProtectedRoute>-wrapped
+ *   (asserted by scripts/gen-product-surface.mjs), which sends them to /login as before.
+ * - While flags load, a loader is shown instead of the page (no flash of hidden UI, no
+ *   premature redirect for opted-in tenants).
+ */
+export function ExperimentalSurfaceGuard({ children }: { children: ReactNode }) {
+  const { pathname } = useLocation();
+  const { user, loading: authLoading } = useAuth();
+  const { ready, isEnabled } = useFeatureFlags();
+  const { toast } = useToast();
+  const gated = isUnverifiedPath(pathname);
+  const [gaveUp, setGaveUp] = useState(false);
+  const toasted = useRef<string | null>(null);
+
+  const waiting = gated && !!user && !ready && !gaveUp;
+  useEffect(() => {
+    if (!waiting) return undefined;
+    const t = setTimeout(() => setGaveUp(true), FLAG_WAIT_MS);
+    return () => clearTimeout(t);
+  }, [waiting, pathname]);
+
+  const allowed = isEnabled(EXPERIMENTAL_SURFACE_FLAG, false);
+  const blocked = gated && !!user && !allowed && (ready || gaveUp);
+
+  useEffect(() => {
+    if (blocked && toasted.current !== pathname) {
+      toasted.current = pathname;
+      toast('That feature is not enabled for your account yet.', 'info');
+    }
+  }, [blocked, pathname, toast]);
+
+  if (!gated) return <>{children}</>;
+  if (authLoading) return <RouteLoader />;
+  if (!user) return <>{children}</>;
+  if (waiting) return <RouteLoader />;
+  if (blocked) return <Navigate to="/dashboard" replace />;
+  return <>{children}</>;
+}
