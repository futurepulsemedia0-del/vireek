--- a/scripts/gen-product-surface.mjs	1970-01-01 00:00:00.000000000 +0000
+++ b/scripts/gen-product-surface.mjs	2026-10-29 11:11:11.491085908 +0000
@@ -0,0 +1,483 @@
+#!/usr/bin/env node
+// Generates docs/product-surface.md — the page-by-page product surface inventory.
+//
+//   node scripts/gen-product-surface.mjs           # (re)write docs/product-surface.md
+//   node scripts/gen-product-surface.mjs --check   # exit 1 if the committed file is stale
+//
+// EVERYTHING here is derived from source text (no network, no DB, no test execution):
+//   - routes:   <Route path=...> elements in src/App.tsx, mapped to src/pages modules
+//   - nav:      PRIMARY_ITEMS / ACCOUNT_ITEMS in src/components/DashboardNav.tsx
+//   - backend:  .from('t') / .rpc('f') / functions.invoke('fn') / /functions/v1/fn found in the
+//               page and in its local imports up to 2 levels deep, then RESOLVED against
+//               supabase/migrations (tables, views, functions) and supabase/functions (dirs).
+//   - tests:    test files that import the page / its backend-bearing modules, pgTAP files that
+//               mention the referenced tables/RPCs, edge-function test files, e2e specs.
+//   - tier:     src/lib/productSurface.manifest.json (longest-prefix match on the route path).
+//
+// "Backend resolved" means the name exists in the repository's migrations / function folders.
+// It does NOT prove the object exists in a live database, and "tests" means a test file exists —
+// it does not mean the test was run or passes.
+
+import { readFileSync, readdirSync, existsSync, writeFileSync, statSync } from 'node:fs';
+import { join, dirname, relative, resolve, sep } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const posix = (p) => p.split(sep).join('/');
+
+// --------------------------------------------------------------------------- fs helpers
+
+function walk(dir, filter, out = []) {
+  if (!existsSync(dir)) return out;
+  for (const e of readdirSync(dir, { withFileTypes: true })) {
+    if (e.name === 'node_modules' || e.name.startsWith('.git')) continue;
+    const p = join(dir, e.name);
+    if (e.isDirectory()) walk(p, filter, out);
+    else if (filter(p)) out.push(p);
+  }
+  return out;
+}
+const read = (p) => readFileSync(p, 'utf8');
+const isTest = (p) => /\.(test|spec)\.(ts|tsx|mjs)$/.test(p) || /_test\.ts$/.test(p);
+
+// --------------------------------------------------------------------------- manifest
+
+export function loadManifest(root) {
+  const m = JSON.parse(read(join(root, 'src/lib/productSurface.manifest.json')));
+  return m;
+}
+
+/** Longest-prefix match of a route pattern / pathname against a list of {path}. */
+export function matchPrefix(list, pathname) {
+  let best = null;
+  for (const e of list) {
+    const p = e.path;
+    if (pathname === p || (!e.exact && pathname.startsWith(p.endsWith('/') ? p : p + '/'))) {
+      if (!best || p.length > best.path.length) best = e;
+    }
+  }
+  return best;
+}
+
+export function tierOfRoute(manifest, pathname) {
+  const c = matchPrefix(manifest.core, pathname);
+  const u = matchPrefix(manifest.unverified, pathname);
+  if (c && u) return c.path.length >= u.path.length ? 'core' : 'unverified';
+  if (c) return 'core';
+  if (u) return 'unverified';
+  return 'secondary';
+}
+
+// --------------------------------------------------------------------------- App.tsx routes
+
+const WRAPPERS = new Set([
+  'ProtectedRoute', 'StaffRoute', 'SupplierRoute', 'TechnicianRoute', 'PartnerRoute', 'Suspense',
+  'PageLoader', 'Navigate', 'HomeTargetGate', 'Route', 'Routes', 'Fragment', 'RouteLoadingFallback',
+  'CustomDomainGate', 'Outlet',
+]);
+
+export function parseApp(appSrc) {
+  const modules = new Map(); // component name -> src/pages module path (no ext)
+  // `c?onst` tolerates a known upload corruption where the leading "c" of "const" is missing.
+  const lazyRe = /(?:^|\n)\s*c?onst\s+(\w+)\s*=\s*lazy\(\s*\(\)\s*=>\s*import\(\s*'@\/pages\/([^']+)'\s*\)/g;
+  for (const m of appSrc.matchAll(lazyRe)) modules.set(m[1], m[2]);
+  for (const m of appSrc.matchAll(/import\s*\{([^}]+)\}\s*from\s*'@\/pages\/([^']+)'/g)) {
+    for (const part of m[1].split(',')) {
+      const name = part.trim().split(/\s+as\s+/).pop();
+      if (name) modules.set(name, m[2]);
+    }
+  }
+  for (const m of appSrc.matchAll(/import\s+(\w+)\s+from\s*'@\/pages\/([^']+)'/g)) modules.set(m[1], m[2]);
+
+  const routes = [];
+  const chunks = appSrc.split(/<Route(?=[\s/>])/).slice(1);
+  for (const chunk of chunks) {
+    const head = chunk.slice(0, 4000);
+    const pm = head.match(/\bpath\s*=\s*(?:"([^"]+)"|\{\s*'([^']+)'\s*\})/);
+    if (!pm) continue; // index/layout routes
+    const path = pm[1] ?? pm[2];
+    const body = head.split(/\/>\s*(?=\n|<|$)/)[0];
+    const comps = [...new Set([...body.matchAll(/<([A-Z][A-Za-z0-9]*)/g)].map((x) => x[1]))].filter((n) => !WRAPPERS.has(n));
+    const component = comps.find((n) => modules.has(n)) ?? null;
+    const guard = /<ProtectedRoute/.test(body) ? 'protected'
+      : /<StaffRoute/.test(body) ? 'staff'
+      : /<TechnicianRoute/.test(body) ? 'technician'
+      : /<SupplierRoute/.test(body) ? 'supplier'
+      : /<PartnerRoute/.test(body) ? 'partner'
+      : 'public';
+    const redirect = /<Navigate\b/.test(body) && !component;
+    routes.push({ path, component, module: component ? modules.get(component) : null, guard, redirect });
+  }
+  return { routes, modules };
+}
+
+// --------------------------------------------------------------------------- nav
+
+export function parseNav(navSrc) {
+  const items = [];
+  const accountIdx = navSrc.indexOf('const ACCOUNT_ITEMS');
+  const re = /\{\s*label:\s*'((?:[^'\\]|\\.)*)'\s*,\s*href:\s*'([^']+)'([^}\n]*)\}/g;
+  for (const m of navSrc.matchAll(re)) {
+    items.push({
+      label: m[1].replace(/\\'/g, "'"),
+      href: m[2],
+      section: accountIdx !== -1 && m.index > accountIdx ? 'account' : 'primary',
+      permission: (m[3].match(/requiresPermission:\s*'([a-z_]+)'/) ?? [])[1] ?? null,
+      ownerOnly: /ownerOnly:\s*true/.test(m[3]),
+    });
+  }
+  return items;
+}
+
+// --------------------------------------------------------------------------- import graph
+
+const EXTS = ['.ts', '.tsx', '/index.ts', '/index.tsx'];
+function resolveImport(root, fromFile, spec) {
+  let base;
+  if (spec.startsWith('@/')) base = join(root, 'src', spec.slice(2));
+  else if (spec.startsWith('.')) base = resolve(dirname(fromFile), spec);
+  else return null;
+  if (/\.(ts|tsx)$/.test(base) && existsSync(base) && statSync(base).isFile()) return base;
+  for (const e of EXTS) if (existsSync(base + e) && statSync(base + e).isFile()) return base + e;
+  return null;
+}
+const importsOf = (src) => [
+  ...[...src.matchAll(/(?:import|export)\s[^'"]*?from\s*['"]([^'"]+)['"]/g)].map((m) => m[1]),
+  ...[...src.matchAll(/import\(\s*['"]([^'"]+)['"]\s*\)/g)].map((m) => m[1]),
+  ...[...src.matchAll(/^import\s+['"]([^'"]+)['"]/gm)].map((m) => m[1]),
+];
+
+// Shared shells / infra that every page imports; following them would attribute the whole app's
+// backend calls to every page.
+const SKIP_DEP = [
+  /\/components\/DashboardNav\.tsx$/, /\/components\/DashboardLayout\.tsx$/, /\/contexts\//, /\/lib\/supabase\.ts$/,
+  /\/components\/ProtectedRoute\.tsx$/, /\/components\/ErrorBoundary\.tsx$/, /\/hooks\/useFeatureFlag\.ts$/,
+  /\/lib\/featureFlagsApi\.ts$/, /\/components\/(?:NotificationBell|AiAssistant|GlobalSearchPalette)\.tsx$/,
+];
+
+const BACKEND_RES = {
+  table: /\.from\(\s*['"`]([a-z0-9_]+)['"`]/g,
+  rpc: /\.rpc\(\s*['"`]([a-z0-9_]+)['"`]/g,
+  edge: /(?:functions\.invoke\(\s*['"`]|\/functions\/v1\/)([a-z0-9][a-z0-9_-]*)/g,
+  auth: /supabase\.auth\.([a-zA-Z]+)/g, // Supabase Auth API (always resolvable; not a repo object)
+};
+function backendOf(src) {
+  const out = { table: new Set(), rpc: new Set(), edge: new Set(), auth: new Set() };
+  for (const [k, re] of Object.entries(BACKEND_RES)) for (const m of src.matchAll(re)) out[k].add(m[1]);
+  return out;
+}
+const hasAny = (b) => b.table.size + b.rpc.size + b.edge.size + b.auth.size > 0;
+
+// --------------------------------------------------------------------------- inventory
+
+export function buildInventory(root) {
+  const manifest = loadManifest(root);
+  const srcDir = join(root, 'src');
+  const rel = (p) => posix(relative(root, p));
+
+  // --- backend universe, from migrations and function dirs
+  const mig = walk(join(root, 'supabase/migrations'), (p) => p.endsWith('.sql'));
+  const known = { table: new Set(), rpc: new Set(), edge: new Set(), auth: { has: () => true } };
+  for (const f of mig) {
+    const s = read(f);
+    for (const m of s.matchAll(/create\s+(?:or\s+replace\s+)?(?:(?:materialized\s+)?view|table)\s+(?:if\s+not\s+exists\s+)?(?:public\.)?"?([a-z0-9_]+)"?/gi)) known.table.add(m[1].toLowerCase());
+    for (const m of s.matchAll(/create\s+(?:or\s+replace\s+)?function\s+(?:public\.)?"?([a-z0-9_]+)"?\s*\(/gi)) known.rpc.add(m[1].toLowerCase());
+  }
+  const fnRoot = join(root, 'supabase/functions');
+  const fnDirs = existsSync(fnRoot) ? readdirSync(fnRoot, { withFileTypes: true }).filter((d) => d.isDirectory() && !d.name.startsWith('_')).map((d) => d.name) : [];
+  fnDirs.forEach((d) => known.edge.add(d));
+  const fnTests = new Set(
+    fnDirs.filter((d) => walk(join(fnRoot, d), isTest).length > 0),
+  );
+
+  // --- test corpora
+  const pgtapText = walk(join(root, 'supabase/tests/database'), (p) => p.endsWith('.sql')).map(read).join('\n').toLowerCase();
+  const e2eFiles = walk(join(root, 'e2e'), (p) => /\.spec\.ts$/.test(p));
+  const e2eText = e2eFiles.map((f) => [rel(f), read(f)]);
+
+  // --- source files, import graph
+  const srcFiles = walk(srcDir, (p) => /\.(ts|tsx)$/.test(p));
+  const cache = new Map();
+  const info = (f) => {
+    if (cache.has(f)) return cache.get(f);
+    const s = read(f);
+    const deps = importsOf(s).map((sp) => resolveImport(root, f, sp)).filter(Boolean);
+    const v = { backend: backendOf(s), deps };
+    cache.set(f, v);
+    return v;
+  };
+  const testedModules = new Set();
+  for (const f of srcFiles.filter(isTest)) for (const d of info(f).deps) testedModules.add(d);
+
+  // --- routes / nav
+  const app = parseApp(read(join(srcDir, 'App.tsx')));
+  const nav = parseNav(read(join(srcDir, 'components/DashboardNav.tsx')));
+  const routesByModule = new Map();
+  for (const r of app.routes) {
+    if (!r.module) continue;
+    if (!routesByModule.has(r.module)) routesByModule.set(r.module, []);
+    routesByModule.get(r.module).push(r);
+  }
+  const navByPath = new Map();
+  for (const n of nav) { if (!navByPath.has(n.href)) navByPath.set(n.href, n); }
+
+  // --- pages
+  const pageFiles = walk(join(srcDir, 'pages'), (p) => /\.tsx$/.test(p) && !isTest(p)).sort();
+  const pages = pageFiles.map((file) => {
+    const mod = posix(relative(join(srcDir, 'pages'), file)).replace(/\.tsx$/, '');
+    // dependency set, depth <= 2, excluding shells
+    const seen = new Map([[file, 0]]);
+    let frontier = [file];
+    for (let depth = 1; depth <= 2; depth++) {
+      const next = [];
+      for (const f of frontier) for (const d of info(f).deps) {
+        if (seen.has(d) || isTest(d) || SKIP_DEP.some((re) => re.test(posix(d)))) continue;
+        if (!/\/src\/(lib|hooks|components|pages)\//.test(posix(d))) continue;
+        seen.set(d, depth); next.push(d);
+      }
+      frontier = next;
+    }
+    const total = { table: new Set(), rpc: new Set(), edge: new Set(), auth: new Set() };
+    const bearing = [];
+    for (const f of seen.keys()) {
+      const b = info(f).backend;
+      if (hasAny(b)) bearing.push(f);
+      for (const k of Object.keys(total)) b[k].forEach((x) => total[k].add(x));
+    }
+    const refs = [
+      ...[...total.table].map((n) => ({ kind: 'table', n })),
+      ...[...total.rpc].map((n) => ({ kind: 'rpc', n })),
+      ...[...total.edge].map((n) => ({ kind: 'edge', n })),
+      ...[...total.auth].map((n) => ({ kind: 'auth', n })),
+    ].map((r) => ({ ...r, ok: known[r.kind].has(r.n.toLowerCase()) }));
+    const resolved = refs.filter((r) => r.ok);
+    const missing = refs.filter((r) => !r.ok);
+    const backend = refs.length === 0 ? 'none' : resolved.length === 0 ? 'dangling' : missing.length ? 'partial' : 'real';
+
+    // Ubiquitous tenant/identity plumbing says nothing about a feature's own DB coverage.
+    const GENERIC_DB = new Set(['get_account_owner_id', 'is_vireek_staff', 'profiles', 'team_members']);
+    const dbTested = refs.filter((r) => (r.kind === 'table' || r.kind === 'rpc') && !GENERIC_DB.has(r.n.toLowerCase()) && new RegExp(`\\b${r.n.toLowerCase()}\\b`).test(pgtapText)).length;
+    const dbTotal = refs.filter((r) => (r.kind === 'table' || r.kind === 'rpc') && !GENERIC_DB.has(r.n.toLowerCase())).length;
+    const fnTested = refs.filter((r) => r.kind === 'edge' && fnTests.has(r.n)).length;
+    const fnTotal = refs.filter((r) => r.kind === 'edge').length;
+    const bearingTested = bearing.filter((f) => testedModules.has(f)).length;
+    const pageTested = testedModules.has(file);
+
+    const routes = routesByModule.get(mod) ?? [];
+    const routePaths = [...new Set(routes.map((r) => r.path))];
+    const e2e = routePaths.filter((p) => e2eText.some(([, t]) => t.includes(`'${p}'`) || t.includes(`"${p}"`) || t.includes(`\`${p}\``))).length;
+    const navEntries = routePaths.map((p) => navByPath.get(p)).filter(Boolean);
+
+    let tier;
+    if (routePaths.length) {
+      const tiers = routePaths.map((p) => tierOfRoute(manifest, p));
+      tier = tiers.includes('core') ? 'core' : tiers.includes('secondary') ? 'secondary' : 'unverified';
+    } else {
+      const u = manifest.unroutedPages?.find((e) => mod === e.module || mod.startsWith(e.module + '/'));
+      tier = u ? u.tier : 'secondary';
+    }
+    return {
+      file: rel(file), module: mod, routes: routePaths, guards: [...new Set(routes.map((r) => r.guard))],
+      nav: navEntries.length > 0, navLabels: navEntries.map((n) => n.label),
+      backend, refs, missing, resolvedCount: resolved.length,
+      tests: { page: pageTested, bearingTested, bearingTotal: bearing.length, dbTested, dbTotal, fnTested, fnTotal, e2e },
+      tier,
+    };
+  });
+  return { root, manifest, pages, routes: app.routes, nav, known: { tables: known.table.size, rpcs: known.rpc.size, edge: known.edge.size }, e2eFiles: e2eFiles.map(rel), pageTestFiles: walk(join(srcDir, 'pages'), isTest).length };
+}
+
+// --------------------------------------------------------------------------- review flags
+
+export function reviewFlags(inv) {
+  const flags = [];
+  const { manifest, routes, pages } = inv;
+  const routePaths = routes.map((r) => r.path);
+  for (const list of ['core', 'unverified']) {
+    for (const e of manifest[list]) {
+      if (!routePaths.some((p) => p === e.path || p.startsWith(e.path + '/'))) {
+        flags.push({ level: 'error', msg: `manifest.${list} "${e.path}" matches no route in src/App.tsx` });
+      }
+    }
+  }
+  for (const e of manifest.unverified) {
+    for (const r of routes) {
+      if ((r.path === e.path || r.path.startsWith(e.path + '/')) && r.guard !== 'protected') {
+        flags.push({ level: 'error', msg: `unverified route "${r.path}" is not wrapped in <ProtectedRoute> (guard=${r.guard}); the flag gate assumes a signed-in tenant` });
+      }
+    }
+  }
+  // The unverified reasons claim "no test evidence" — enforce it instead of trusting the manifest.
+  for (const p of pages) {
+    if (p.tier !== 'unverified' || !p.routes.length) continue;
+    const t = p.tests;
+    if (t.page || t.bearingTested || t.dbTested || t.fnTested || t.e2e) {
+      flags.push({ level: 'error', msg: `Unverified page ${p.module} has test evidence (${testsCell(p)}) — reclassify or fix the manifest reason` });
+    }
+  }
+  // Server-side enforcement: edge functions behind an unverified page must refuse tenants
+  // without the flag (UI hiding alone leaves them callable). Functions also used by
+  // core/secondary pages cannot be gated this way and are reported separately.
+  const exempt = new Set((manifest.serverGateExempt ?? []).map((e) => e.function));
+  const usedElsewhere = new Set(pages.filter((p) => p.tier !== 'unverified').flatMap((p) => p.refs.filter((r) => r.kind === 'edge').map((r) => r.n)));
+  const gateFns = new Set(pages.filter((p) => p.tier === 'unverified').flatMap((p) => p.refs.filter((r) => r.kind === 'edge' && r.ok).map((r) => r.n)));
+  for (const fn of [...gateFns].sort()) {
+    if (exempt.has(fn)) continue;
+    const f = join(inv.root, 'supabase/functions', fn, 'index.ts');
+    if (!existsSync(f)) continue;
+    if (usedElsewhere.has(fn)) {
+      flags.push({ level: 'warn', msg: `edge function ${fn} backs an unverified page but is also used by core/secondary pages — cannot be flag-gated` });
+    } else if (!/userHasFlag\(/.test(read(f))) {
+      flags.push({ level: 'error', msg: `edge function ${fn} backs an unverified page but does not call userHasFlag() — it is still callable by tenants without the flag` });
+    }
+  }
+  // Static link lists that would advertise a hidden route (the route guard still catches them).
+  for (const f of ['src/components/CommandPalette.tsx', 'src/lib/keyboardShortcuts.ts', 'src/components/mobile/MobileBottomNav.tsx']) {
+    const abs = join(inv.root, f);
+    if (!existsSync(abs)) continue;
+    const src = read(abs);
+    for (const m of src.matchAll(/['"`](\/[a-z0-9\-/]+)['"`]/g)) {
+      if (tierOfRoute(manifest, m[1]) === 'unverified') flags.push({ level: 'warn', msg: `${f} links to unverified route ${m[1]} (hidden by the route guard, but still listed)` });
+    }
+  }
+  for (const p of pages) {
+    if (p.tier === 'core' && p.routes.length && (p.backend === 'none' || p.backend === 'dangling')) {
+      flags.push({ level: 'warn', msg: `Core page ${p.module} has backend=${p.backend} — confirm it is data-backed` });
+    }
+    if (p.tier === 'core' && p.missing.length) {
+      flags.push({ level: 'warn', msg: `Core page ${p.module} references names not found in migrations/functions: ${p.missing.map((m) => `${m.kind}:${m.n}`).join(', ')}` });
+    }
+  }
+  return flags;
+}
+
+// --------------------------------------------------------------------------- markdown
+
+const TIER_LABEL = { core: 'Core', secondary: 'Secondary', unverified: 'Unverified' };
+const esc = (s) => String(s).replace(/\|/g, '\\|');
+function backendCell(p) {
+  if (p.refs.length === 0) return 'none';
+  const ok = p.refs.filter((r) => r.ok);
+  const tag = (r) => (r.kind === 'table' ? r.n : r.kind === 'rpc' ? `${r.n}()` : r.kind === 'auth' ? `auth.${r.n}` : `fn:${r.n}`);
