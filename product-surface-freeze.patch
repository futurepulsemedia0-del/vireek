--- a/src/lib/productSurface.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/lib/productSurface.ts	2026-10-29 11:11:11.756960034 +0000
@@ -0,0 +1,93 @@
+// Pilot product-surface freeze — pure logic (no React, no network).
+//
+// The tiers live in productSurface.manifest.json (single source of truth, also read by
+// scripts/gen-product-surface.mjs which writes docs/product-surface.md).
+//
+//   core        part of the pilot product; always in the nav
+//   secondary   shipped; routes always work, but the NAV lists it only for tenants with the
+//               `full_navigation` flag (new tenants see Core nav only)
+//   unverified  abstract / experimental: nav entry AND route hidden unless the tenant has the
+//               `experimental_surface` flag
+//   Both flags use the existing feature_flags mechanism; existing tenants are grandfathered ON
+//   by the migration, so only tenants created after the freeze get the reduced surface.
+//
+// IMPORTANT: this is a UI freeze, not an authorization boundary. Tenant isolation and
+// permissions are enforced by RLS / edge functions, exactly as before. Nothing is deleted.
+import manifest from './productSurface.manifest.json';
+
+export type SurfaceTier = 'core' | 'secondary' | 'unverified';
+
+export interface SurfaceEntry {
+  path: string;
+  exact?: boolean;
+  reason?: string;
+  domain?: string;
+}
+
+export const EXPERIMENTAL_SURFACE_FLAG: string = manifest.flagKey;
+export const FULL_NAVIGATION_FLAG: string = manifest.navFlagKey;
+export const CORE_ENTRIES: readonly SurfaceEntry[] = manifest.core;
+export const UNVERIFIED_ENTRIES: readonly SurfaceEntry[] = manifest.unverified;
+
+/**
+ * Canonical form used for matching. React Router matches case-insensitively, decodes the path
+ * and ignores trailing slashes, so the freeze must too — otherwise `/dashboard/Entropy` or
+ * `/dashboard/%65ntropy/` would slip past a case-sensitive prefix check.
+ */
+export function normalizePath(input: string): string {
+  let p = input.split('#')[0].split('?')[0];
+  try {
+    p = decodeURIComponent(p);
+  } catch {
+    /* malformed escape: keep the raw string */
+  }
+  p = p.toLowerCase().replace(/\/{2,}/g, '/');
+  if (p.length > 1 && p.endsWith('/')) p = p.slice(0, -1);
+  return p || '/';
+}
+
+/** Longest matching entry; `exact` entries only match the identical path. */
+export function matchEntry(entries: readonly SurfaceEntry[], pathname: string): SurfaceEntry | null {
+  let best: SurfaceEntry | null = null;
+  for (const e of entries) {
+    const hit = pathname === e.path || (!e.exact && pathname.startsWith(`${e.path}/`));
+    if (hit && (!best || e.path.length > best.path.length)) best = e;
+  }
+  return best;
+}
+
+export function tierOfPath(input: string): SurfaceTier {
+  const p = normalizePath(input);
+  const c = matchEntry(CORE_ENTRIES, p);
+  const u = matchEntry(UNVERIFIED_ENTRIES, p);
+  if (c && u) return c.path.length >= u.path.length ? 'core' : 'unverified';
+  if (c) return 'core';
+  if (u) return 'unverified';
+  return 'secondary';
+}
+
+export const isUnverifiedPath = (pathname: string): boolean => tierOfPath(pathname) === 'unverified';
+
+/** True when a ROUTE must be blocked for this tenant (only unverified routes are ever blocked). */
+export function isSurfaceHidden(pathname: string, experimentalEnabled: boolean): boolean {
+  return !experimentalEnabled && isUnverifiedPath(pathname);
+}
+
+export interface SurfaceFlags {
+  /** `experimental_surface`: unverified pages are reachable and listed (with a Beta badge). */
+  experimental: boolean;
+  /** `full_navigation`: secondary pages are listed in the nav (they are always reachable by URL). */
+  fullNav: boolean;
+}
+
+/** Should this href appear in the dashboard nav for a tenant with these flags? */
+export function isNavVisible(href: string, flags: SurfaceFlags): boolean {
+  const tier = tierOfPath(href);
+  if (tier === 'core') return true;
+  return tier === 'unverified' ? flags.experimental : flags.fullNav;
+}
+
+/** Nav helper; generic so DashboardNav's own NavItem type flows through unchanged. */
+export function filterNav<T extends { href: string }>(items: readonly T[], flags: SurfaceFlags): T[] {
+  return items.filter((i) => isNavVisible(i.href, flags));
+}
