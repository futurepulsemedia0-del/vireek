@@ -0,0 +1,42 @@
+/*
+  # Server-side check for the product-surface flags
+
+  The UI freeze (20271231130000) hides unverified pages, but their edge functions stayed
+  callable by any authenticated tenant. Edge functions use this helper to enforce the same
+  flag on the server.
+
+  user_flag_is_on(user, key)
+    - resolves the tenant exactly like get_account_owner_id() (owner = own profile, team
+      member = their account owner), then evaluates the flag with feature_flag_is_on()
+    - FAIL CLOSED: unknown user, unknown flag or no tenant => false
+    - service_role only: tenants cannot probe other users' flags
+
+  No tables or policies change. Rollback: DROP FUNCTION public.user_flag_is_on(uuid, text);
+  (the gated functions then deny, so revert them first).
+*/
+
+CREATE OR REPLACE FUNCTION public.user_flag_is_on(p_user uuid, p_key text)
+RETURNS boolean
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = public
+AS $$
+  WITH t AS (
+    SELECT COALESCE(
+      (SELECT id FROM profiles WHERE id = p_user),
+      (SELECT tm.account_owner_id FROM team_members tm
+        WHERE tm.member_email = (SELECT email FROM auth.users WHERE id = p_user) LIMIT 1)
+    ) AS tenant
+  )
+  SELECT COALESCE((
+    SELECT public.feature_flag_is_on(f.enabled, f.rollout_pct, o.state, t.tenant, f.key)
+      FROM t
+      JOIN feature_flags f ON f.key = p_key
+      LEFT JOIN feature_flag_overrides o ON o.flag_id = f.id AND o.tenant_id = t.tenant
+     WHERE t.tenant IS NOT NULL
+  ), false);
+$$;
+
+REVOKE ALL ON FUNCTION public.user_flag_is_on(uuid, text) FROM PUBLIC, anon, authenticated;
+GRANT EXECUTE ON FUNCTION public.user_flag_is_on(uuid, text) TO service_role;
