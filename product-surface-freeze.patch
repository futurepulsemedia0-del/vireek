+}
+function testsCell(p) {
+  const t = p.tests;
+  const parts = [`page ${t.page ? 'Y' : 'N'}`];
+  parts.push(`mods ${t.bearingTested}/${t.bearingTotal}`);
+  parts.push(`db ${t.dbTested}/${t.dbTotal}`);
+  parts.push(`fn ${t.fnTested}/${t.fnTotal}`);
+  parts.push(`e2e ${t.e2e}`);
+  return parts.join(' · ');
+}
+
+export function renderMarkdown(inv) {
