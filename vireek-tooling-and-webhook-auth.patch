+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test('CLI: --write-baseline then check passes; fixing the file makes the baseline stale (fails)', () => {
+  const dir = tmpRepo({ gone: 'node scripts/gone.mjs' });
