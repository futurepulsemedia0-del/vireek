{
  "_meta": {
    "status": "UNREVIEWED - NO THRESHOLD VALUES HAVE BEEN ENTERED. [COUNSEL][VERIFY]",
    "instructions": [
      "Every threshold below is null on purpose. Do not fill a value unless counsel/finance has verified it against the jurisdiction's current official rule and recorded sourceUrl, reviewedBy and reviewedOn.",
      "revenueThresholdCents: integer minor units of `currency` (e.g. 10000000 = 100,000.00). transactionThreshold: integer invoice count. Either or both may be set.",
      "window: one of rolling_12m | calendar_year | prior_or_current_calendar_year. basis: gross | net_of_tax. comparison: gte | gt. [COUNSEL]",
      "currency: lower-case ISO 4217 code. Revenue is never converted (no FX); a row in another currency is shown as currency_mismatch and not compared.",
      "To track another country add a top-level key with its ISO 3166-1 alpha-2 code (e.g. \"NL\"). US states use \"US-<USPS code>\"."
    ],
    "tags": [
      "COUNSEL",
      "VERIFY"
    ]
  },
  "alerting": {
    "approachingRatio": 0.8,
    "note": "Internal early-warning setting, not a legal value. Status is 'approaching' when revenue or transactions reach this fraction of a configured threshold. [COUNSEL] to confirm the margin."
  },
