+
+function ExampleTranscript() {
+  const reduceMotion = useReducedMotion();
+  const [index, setIndex] = useState(0);
+
+  useEffect(() => {
+    if (reduceMotion) return;
+    const id = window.setInterval(() => setIndex((i) => (i + 1) % EXAMPLE_LINES.length), 3600);
