--- a/src/components/home/DemoFallback.tsx	1970-01-01 00:00:00.000000000 +0000
+++ b/src/components/home/DemoFallback.tsx	2026-10-31 05:59:32.346087153 +0000
@@ -0,0 +1,83 @@
+import { useEffect, useState } from 'react';
+import { Phone } from 'lucide-react';
+import { ButtonAnchor } from '@/components/ui/ButtonLink';
+import { SARAH_PHONE } from '@/lib/site';
+import { SARAH_SAMPLE_AUDIO } from '@/lib/homeContent';
+import { trackDemoStart } from '@/lib/homeAnalytics';
+import { exampleChip } from './sectionStyles';
+
+export type MicStatus = 'unknown' | 'ok' | 'unsupported' | 'denied';
+
+/** Best-effort microphone check. Never prompts; falls back to 'unknown' where the Permissions API lacks "microphone" (Safari). */
+export function useMicStatus(forceDenied: boolean): MicStatus {
+  const [status, setStatus] = useState<MicStatus>('unknown');
+
+  useEffect(() => {
+    if (!navigator.mediaDevices?.getUserMedia) {
+      setStatus('unsupported');
+      return;
+    }
+    let cancelled = false;
+    let result: PermissionStatus | null = null;
+    const apply = () => result && !cancelled && setStatus(result.state === 'denied' ? 'denied' : 'ok');
+    navigator.permissions
+      ?.query({ name: 'microphone' as PermissionName })
+      .then((r) => {
+        result = r;
+        apply();
+        r.addEventListener('change', apply);
+      })
+      .catch(() => undefined);
+    return () => {
+      cancelled = true;
+      result?.removeEventListener('change', apply);
+    };
+  }, []);
+
+  return forceDenied ? 'denied' : status;
+}
+
+const EXAMPLE_TRANSCRIPT = [
+  ['Caller', 'Hi, my water heater is leaking all over the garage.'],
+  ['Sarah', 'I’m sorry to hear that. Is water running right now, or has it stopped?'],
+  ['Caller', 'It’s still running.'],
+  ['Sarah', 'Thanks. I’m flagging this as an emergency. Can I get your address?'],
+  ['Sarah', 'I can have a technician there today at 2:30. Does that work?'],
+] as const;
+
+export function DemoFallback({ reason }: { reason: Exclude<MicStatus, 'ok' | 'unknown'> }) {
+  return (
+    <div className="flex flex-col gap-4 rounded-2xl border border-border bg-bg-secondary p-6" data-testid="demo-fallback">
+      <div className="flex items-center justify-between gap-3">
+        <h3 className="text-base font-semibold text-text-primary">Can’t use your microphone? Read a call instead</h3>
+        <span className={exampleChip}>Example</span>
+      </div>
+      <p role="status" className="text-sm text-text-secondary">
+        {reason === 'denied'
+          ? 'Microphone access is blocked for this site. You can allow it in your browser settings, type to Sarah in the chat, call her, or read this example.'
+          : 'This browser can’t use a microphone here. Type to Sarah in the chat, call her, or read this example.'}
+      </p>
+
+      {SARAH_SAMPLE_AUDIO && (
+        <audio controls preload="none" src={SARAH_SAMPLE_AUDIO.src} className="w-full" onPlay={() => trackDemoStart('fallback_transcript')}>
+          Your browser does not support audio playback.
+        </audio>
+      )}
+
+      <ol className="space-y-2 text-sm" aria-label="Example call transcript">
+        {EXAMPLE_TRANSCRIPT.map(([who, line], i) => (
+          <li key={i} className="flex gap-2">
+            <span className="w-14 shrink-0 font-semibold text-text-primary">{who}</span>
+            <span className="text-text-secondary">{line}</span>
+          </li>
+        ))}
+      </ol>
+      <p className="text-xs text-text-secondary">Illustrative transcript written for this page, not a real customer call.</p>
+
+      <ButtonAnchor href={SARAH_PHONE} variant="secondary" onClick={() => trackDemoStart('phone')}>
+        <Phone size={16} aria-hidden="true" />
+        Call Sarah instead
+      </ButtonAnchor>
+    </div>
+  );
+}
