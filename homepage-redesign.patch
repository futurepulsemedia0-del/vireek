@@ -0,0 +1,30 @@
+import { describe, expect, it } from 'vitest';
+import { CALCULATOR_DEFAULTS, calculateMissedCallCost } from './missedCallMath';
+
+describe('calculateMissedCallCost', () => {
+  it('matches the formula shown on the page for the default inputs', () => {
+    // 50 calls/wk × 20% missed × 52/12 = 43.33 missed/mo; × 30% = 13 jobs; × $350 = $4,550
+    const r = calculateMissedCallCost(CALCULATOR_DEFAULTS);
+    expect(r.missedPerMonth).toBeCloseTo(43.333, 2);
+    expect(r.bookedJobsPerMonth).toBeCloseTo(13, 5);
+    expect(r.monthlyRevenueAtStake).toBeCloseTo(4550, 2);
+    expect(r.annualRevenueAtStake).toBeCloseTo(54600, 2);
+  });
+
+  it('returns zero when nothing is missed', () => {
+    const r = calculateMissedCallCost({ ...CALCULATOR_DEFAULTS, missedPercent: 0 });
+    expect(r.monthlyRevenueAtStake).toBe(0);
+  });
+
+  it('clamps out-of-range and non-finite input instead of producing NaN or negatives', () => {
+    const r = calculateMissedCallCost({ callsPerWeek: -5, missedPercent: 500, bookRatePercent: NaN, jobValue: Infinity });
+    expect(Number.isFinite(r.monthlyRevenueAtStake)).toBe(true);
+    expect(r.monthlyRevenueAtStake).toBeGreaterThanOrEqual(0);
+  });
+
+  it('scales linearly with job value', () => {
+    const a = calculateMissedCallCost({ ...CALCULATOR_DEFAULTS, jobValue: 100 });
+    const b = calculateMissedCallCost({ ...CALCULATOR_DEFAULTS, jobValue: 200 });
+    expect(b.monthlyRevenueAtStake).toBeCloseTo(a.monthlyRevenueAtStake * 2, 5);
+  });
+});
