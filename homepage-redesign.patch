+
+/** Loads the typed-signature fonts on demand. They used to be a render-blocking @import on every page. */
+export function ensureSignatureFonts(): void {
+  if (typeof document === 'undefined' || document.querySelector('link[data-signature-fonts]')) return;
+  const link = document.createElement('link');
+  link.rel = 'stylesheet';
+  link.href = HREF;
+  link.setAttribute('data-signature-fonts', '1');
+  document.head.appendChild(link);
+}
