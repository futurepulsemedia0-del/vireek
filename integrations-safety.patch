@@ -0,0 +1,71 @@
+import { describe, expect, it } from 'vitest';
+import { claimJobSync, decideClaim } from './jobSyncClaim';
+
+const NOW = Date.parse('2026-11-13T12:00:00Z');
+const iso = (msAgo: number) => new Date(NOW - msAgo).toISOString();
+
+describe('decideClaim', () => {
+  it('inserts when nothing exists', () => expect(decideClaim(null, NOW)).toBe('insert'));
+  it('skips an already synced job (no duplicate in the FSM)', () => expect(decideClaim({ status: 'synced', updated_at: iso(1e9) }, NOW)).toBe('skip_synced'));
+  it('skips a fresh pending job, takes over a stale one', () => {
+    expect(decideClaim({ status: 'pending', updated_at: iso(10_000) }, NOW)).toBe('skip_inflight');
+    expect(decideClaim({ status: 'pending', updated_at: iso(10 * 60_000) }, NOW)).toBe('takeover');
+  });
+  it('retries errors and not_connected', () => {
+    expect(decideClaim({ status: 'error', updated_at: iso(1000) }, NOW)).toBe('takeover');
+    expect(decideClaim({ status: 'not_connected', updated_at: iso(1000) }, NOW)).toBe('takeover');
+  });
+});
+
+/** Tiny in-memory job_external_syncs with unique(job_id, provider) and a CAS-capable update. */
+function fakeDb(initial: Array<Record<string, any>> = []) {
+  const rows = [...initial];
+  const find = (f: Record<string, any>) => rows.filter((r) => Object.entries(f).every(([k, v]) => r[k] === v));
+  return {
+    rows,
+    from() {
+      const filters: Record<string, any> = {};
+      let op: 'select' | 'update' = 'select';
+      let patch: any = null;
+      const b: any = {
+        select: () => b,
+        eq: (k: string, v: any) => ((filters[k] = v), b),
+        update: (p: any) => ((op = 'update'), (patch = p), b),
+        maybeSingle: async () => ({ data: find(filters)[0] ?? null, error: null }),
+        insert: async (row: any) => {
+          if (find({ job_id: row.job_id, provider: row.provider }).length) return { error: { code: '23505' } };
+          rows.push({ ...row, id: String(rows.length + 1), updated_at: new Date(NOW).toISOString() });
+          return { error: null };
+        },
+        then: (res: any) => {
+          const hit = find(filters);
+          if (op === 'update') hit.forEach((r) => Object.assign(r, patch, { updated_at: new Date(NOW + 1).toISOString() }));
+          return Promise.resolve({ data: hit.map((r) => ({ id: r.id })), error: null }).then(res);
+        },
+      };
+      return b;
+    },
+  };
+}
+
+describe('claimJobSync', () => {
+  it('first caller wins, replay is rejected', async () => {
+    const db = fakeDb();
+    expect(await claimJobSync(db, 'u', 'j1', 'jobber', NOW)).toBe(true);
+    expect(await claimJobSync(db, 'u', 'j1', 'jobber', NOW)).toBe(false);
+    expect(await claimJobSync(db, 'u', 'j1', 'service_titan', NOW)).toBe(true);
+  });
+  it('never re-pushes a synced job', async () => {
+    const db = fakeDb([{ id: '1', job_id: 'j1', provider: 'jobber', status: 'synced', updated_at: iso(5e6) }]);
+    expect(await claimJobSync(db, 'u', 'j1', 'jobber', NOW)).toBe(false);
+  });
+  it('retries a failed job exactly once under a stale observation (CAS)', async () => {
+    const db = fakeDb([{ id: '1', job_id: 'j1', provider: 'jobber', status: 'error', updated_at: iso(5000) }]);
+    expect(await claimJobSync(db, 'u', 'j1', 'jobber', NOW)).toBe(true);
+    expect(db.rows[0].status).toBe('pending');
+  });
+  it('fails closed when the database throws', async () => {
+    const boom = { from: () => { throw new Error('db down'); } };
+    expect(await claimJobSync(boom, 'u', 'j1', 'jobber', NOW)).toBe(false);
+  });
+});
diff --git a/supabase/functions/_shared/dispatch/jobSyncClaim.ts b/supabase/functions/_shared/dispatch/jobSyncClaim.ts
new file mode 100644
index 0000000..536abda
--- /dev/null
+++ b/supabase/functions/_shared/dispatch/jobSyncClaim.ts
@@ -0,0 +1,71 @@
+// supabase/functions/_shared/dispatch/jobSyncClaim.ts
+//
+// Idempotency for "push a booked job to an external FSM". job_external_syncs has UNIQUE (job_id, provider), so that
+// pair is the idempotency key. Before pushing, a caller CLAIMS the pair:
+//   - no row            -> INSERT a 'pending' row (unique constraint arbitrates concurrent callers)
+//   - 'synced'          -> skip (already created externally; a webhook retry must not create a duplicate)
+//   - fresh 'pending'   -> skip (another invocation is in flight)
+//   - 'error' / 'not_connected' / stale 'pending' -> take over with a compare-and-swap on updated_at
+// Only the winner proceeds. Never throws: any DB failure means "do not push" (fail closed against duplicates;
+// the failure is logged and the job stays retryable).
+
+export type ClaimDecision = "insert" | "skip_synced" | "skip_inflight" | "takeover";
+
+export const PENDING_STALE_MS = 2 * 60 * 1000;
+
+export function decideClaim(existing: { status: string; updated_at: string } | null, nowMs: number, staleMs = PENDING_STALE_MS): ClaimDecision {
+  if (!existing) return "insert";
+  if (existing.status === "synced") return "skip_synced";
+  if (existing.status === "pending") {
+    const age = nowMs - Date.parse(existing.updated_at);
+    return Number.isFinite(age) && age < staleMs ? "skip_inflight" : "takeover";
+  }
+  return "takeover";
+}
+
+// Minimal structural type so this module has no npm: import (unit-testable).
+interface Db {
+  from(table: string): any; // eslint-disable-line @typescript-eslint/no-explicit-any
+}
+
+export async function claimJobSync(
+  admin: Db,
+  userId: string,
+  jobId: string,
+  provider: "jobber" | "service_titan" | "housecall_pro",
+  nowMs: number = Date.now(),
+): Promise<boolean> {
+  try {
+    const { data: existing, error: readErr } = await admin
+      .from("job_external_syncs")
+      .select("status, updated_at")
+      .eq("job_id", jobId)
+      .eq("provider", provider)
+      .maybeSingle();
+    if (readErr) throw new Error("claim_read_failed");
+
+    const decision = decideClaim(existing ?? null, nowMs);
+    if (decision === "skip_synced" || decision === "skip_inflight") return false;
+
+    if (decision === "insert") {
+      const { error } = await admin.from("job_external_syncs").insert({ user_id: userId, job_id: jobId, provider, status: "pending" });
+      if (!error) return true;
+      if ((error as { code?: string }).code === "23505") return false; // lost the race
+      throw new Error("claim_insert_failed");
+    }
+
+    // takeover: compare-and-swap on the updated_at we observed; exactly one concurrent caller gets a row back.
+    const { data: won, error: casErr } = await admin
+      .from("job_external_syncs")
+      .update({ status: "pending", error_message: null })
+      .eq("job_id", jobId)
+      .eq("provider", provider)
+      .eq("updated_at", existing.updated_at)
+      .select("id");
+    if (casErr) throw new Error("claim_cas_failed");
+    return Array.isArray(won) && won.length === 1;
+  } catch (error) {
+    console.error(JSON.stringify({ event: "job_sync_claim_failed", provider, job_id: jobId, error: error instanceof Error ? error.message : String(error) }));
+    return false;
+  }
+}
