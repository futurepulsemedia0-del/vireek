diff --git a/supabase/migrations/20290304000000_integrations_permission_and_st_flag.sql b/supabase/migrations/20290304000000_integrations_permission_and_st_flag.sql
new file mode 100644
index 0000000..02aa3e2
--- /dev/null
+++ b/supabase/migrations/20290304000000_integrations_permission_and_st_flag.sql
@@ -0,0 +1,81 @@
+/*
+  Integrations safety pack.
+
+  1. public.can_manage_integrations()  - permission used by the Jobber / HubSpot / Google Calendar OAuth start
+     functions and the ServiceTitan connect function. Same rule as can_manage_quickbooks(): business-profile edit
+     AND billing view (owners always pass via has_account_permission's "no team_members row" branch).
+  2. Feature flag `servicetitan_app_key_onboarding`, seeded OFF (enabled=false, rollout 0). New tenants cannot hand
+     Vireek their ServiceTitan App Key; tenants with a live connection are grandfathered in code
+     (price-book-connect-servicetitan), not by this flag.
+  3. oauth_state_consumed + oauth_state_consume(): single-use enforcement for signed OAuth state nonces.
+
+  Prerequisites (verified in this repo): has_account_permission(text) [20270503000000_crm_sync.sql],
+  feature_flags [20270411000100_feature_flags.sql; kind/risk/owner columns in 20280501000000_release_safety_core.sql].
+
+  ROLLBACK (manual, in this order):
+    DROP FUNCTION IF EXISTS public.oauth_state_consume(text, text);
+    DROP TABLE IF EXISTS public.oauth_state_consumed;
+    DELETE FROM public.feature_flags WHERE key = 'servicetitan_app_key_onboarding';
+    DROP FUNCTION IF EXISTS public.can_manage_integrations();
+  (Roll back the edge-function changes first; they call these objects.)
+*/
+
+-- 1. PERMISSION ---------------------------------------------------------------------------------------------
+CREATE OR REPLACE FUNCTION public.can_manage_integrations()
+RETURNS boolean
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = public
+AS $$
+  SELECT public.has_account_permission('can_edit_business_profile')
+     AND public.has_account_permission('can_view_billing');
+$$;
+REVOKE ALL ON FUNCTION public.can_manage_integrations() FROM PUBLIC, anon;
+GRANT EXECUTE ON FUNCTION public.can_manage_integrations() TO authenticated;
+
+-- 2. FEATURE FLAG (default OFF) -----------------------------------------------------------------------------
+INSERT INTO public.feature_flags (key, name, description, enabled, rollout_pct, kind, risk)
+VALUES (
+  'servicetitan_app_key_onboarding',
+  'ServiceTitan App-Key onboarding',
+  'When OFF (default) new tenants cannot connect ServiceTitan by pasting their own App Key (ServiceTitan treats this as tunneling). Tenants with an existing connection keep working.',
+  false, 0, 'ops', 'high'
+)
+ON CONFLICT (key) DO NOTHING;
+
+-- 3. SINGLE-USE OAUTH STATE ---------------------------------------------------------------------------------
+CREATE TABLE IF NOT EXISTS public.oauth_state_consumed (
+  nonce text PRIMARY KEY CHECK (nonce ~ '^[0-9a-f]{24}$'),
+  provider text NOT NULL CHECK (char_length(provider) BETWEEN 1 AND 40),
+  consumed_at timestamptz NOT NULL DEFAULT now()
+);
+CREATE INDEX IF NOT EXISTS oauth_state_consumed_at_idx ON public.oauth_state_consumed (consumed_at);
+ALTER TABLE public.oauth_state_consumed ENABLE ROW LEVEL SECURITY;  -- no policies: service_role only
+REVOKE ALL ON public.oauth_state_consumed FROM PUBLIC, anon, authenticated;
+
+-- Returns true only for the FIRST consumption of a nonce. States live 10 minutes, so rows older than 1 day are
+-- safe to prune (pruned opportunistically here to avoid needing a cron job).
+CREATE OR REPLACE FUNCTION public.oauth_state_consume(p_nonce text, p_provider text)
+RETURNS boolean
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = public
+AS $$
+DECLARE
+  v_rows integer;
+BEGIN
+  IF p_nonce IS NULL OR p_nonce !~ '^[0-9a-f]{24}$' THEN
+    RETURN false;
+  END IF;
+  INSERT INTO public.oauth_state_consumed (nonce, provider) VALUES (p_nonce, left(coalesce(p_provider, 'unknown'), 40))
+  ON CONFLICT (nonce) DO NOTHING;
+  GET DIAGNOSTICS v_rows = ROW_COUNT;
+  IF random() < 0.02 THEN
+    DELETE FROM public.oauth_state_consumed WHERE consumed_at < now() - interval '1 day';
+  END IF;
+  RETURN v_rows = 1;
+END;
+$$;
+REVOKE ALL ON FUNCTION public.oauth_state_consume(text, text) FROM PUBLIC, anon, authenticated;
+GRANT EXECUTE ON FUNCTION public.oauth_state_consume(text, text) TO service_role;
diff --git a/supabase/migrations/20290304000100_integration_health_and_drift.sql b/supabase/migrations/20290304000100_integration_health_and_drift.sql
new file mode 100644
index 0000000..afbac6c
--- /dev/null
+++ b/supabase/migrations/20290304000100_integration_health_and_drift.sql
@@ -0,0 +1,60 @@
+/*
+  Integration health + drift reports.
+
+  - integration_drift_reports: written ONLY by the integration-reconcile edge function (service_role). Drift is surfaced,
+    never auto-fixed. Owners/team read their own rows.
+  - get_integration_health(): one call for the UI: per provider connection status, last successful sync, last error,
+    open drift count, failed job pushes (job_external_syncs.status='error') in the last 30 days.
+    job_external_syncs rows with status 'error' ARE the dead-letter queue for job write-back (verified: schema in
+    20261001000000_job_external_sync.sql; jobSyncClaim.ts lets them be retried exactly once at a time).
+
+  Prerequisites: price_book_connections, job_external_syncs, get_account_owner_id().
+
+  ROLLBACK:
+    DROP FUNCTION IF EXISTS public.get_integration_health();
+    DROP TABLE IF EXISTS public.integration_drift_reports;
+*/
+
+CREATE TABLE IF NOT EXISTS public.integration_drift_reports (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  user_id uuid NOT NULL,
+  provider text NOT NULL CHECK (provider IN ('jobber', 'service_titan', 'housecall_pro')),
+  status text NOT NULL DEFAULT 'open' CHECK (status IN ('open', 'resolved')),
+  total integer NOT NULL CHECK (total >= 0),
+  missing_in_vireek integer NOT NULL DEFAULT 0,
+  missing_in_provider integer NOT NULL DEFAULT 0,
+  price_mismatch integer NOT NULL DEFAULT 0,
+  active_mismatch integer NOT NULL DEFAULT 0,
+  details jsonb NOT NULL DEFAULT '{}'::jsonb CHECK (jsonb_typeof(details) = 'object'),
+  detected_at timestamptz NOT NULL DEFAULT now(),
+  resolved_at timestamptz
+);
+CREATE INDEX IF NOT EXISTS idx_integration_drift_open ON public.integration_drift_reports (user_id, provider) WHERE status = 'open';
+
+ALTER TABLE public.integration_drift_reports ENABLE ROW LEVEL SECURITY;
+REVOKE ALL ON public.integration_drift_reports FROM PUBLIC, anon, authenticated;
+GRANT SELECT ON public.integration_drift_reports TO authenticated;
+DROP POLICY IF EXISTS "select_own_integration_drift" ON public.integration_drift_reports;
+CREATE POLICY "select_own_integration_drift" ON public.integration_drift_reports
+  FOR SELECT TO authenticated
+  USING (user_id = auth.uid() OR user_id = public.get_account_owner_id());
+
+CREATE OR REPLACE FUNCTION public.get_integration_health()
+RETURNS TABLE (provider text, status text, last_synced_at timestamptz, last_sync_error text, open_drift integer, failed_job_pushes_30d integer)
+LANGUAGE sql
+STABLE
+SECURITY DEFINER
+SET search_path = public
+AS $$
+  SELECT c.provider, c.status, c.last_synced_at, c.last_sync_error,
+         COALESCE((SELECT sum(d.total)::integer FROM integration_drift_reports d
+                    WHERE d.user_id = c.user_id AND d.provider = c.provider AND d.status = 'open'), 0),
+         COALESCE((SELECT count(*)::integer FROM job_external_syncs j
+                    WHERE j.user_id = public.get_account_owner_id() AND j.provider = c.provider
+                      AND j.status = 'error' AND j.updated_at > now() - interval '30 days'), 0)
+    FROM price_book_connections c
+   WHERE c.user_id IN (auth.uid(), public.get_account_owner_id())
+     AND c.status <> 'disconnected';
+$$;
+REVOKE ALL ON FUNCTION public.get_integration_health() FROM PUBLIC, anon;
+GRANT EXECUTE ON FUNCTION public.get_integration_health() TO authenticated;
