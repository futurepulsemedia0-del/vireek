{
  "__inputs": [
    {
      "name": "DS_POSTGRES",
      "label": "Vireek Postgres (read-only role grafana_voice_ro)",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "title": "Vireek voice observability",
  "uid": "vireek-voice-obs",
  "tags": [
    "vireek",
    "voice",
    "slo"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Answer rate",
      "description": "Share of calls where the AI spoke at least once. Calls that never reach Vapi are not visible here.",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ts,$__interval), avg(answered::int) AS answer_rate FROM obs_grafana_calls WHERE $__timeFilter(ts) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Call completion rate",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ts,$__interval), avg(completed::int) AS completion FROM obs_grafana_calls WHERE $__timeFilter(ts) AND answered AND completed IS NOT NULL GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Turn latency p50 / p95 / p99",
      "description": "Alert thresholds: p95 > 2500 ms warn (SEV3), > 4000 ms critical (SEV2).",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ts,$__interval), percentile_cont(0.5) WITHIN GROUP (ORDER BY x.ms) AS p50, percentile_cont(0.95) WITHIN GROUP (ORDER BY x.ms) AS p95, percentile_cont(0.99) WITHIN GROUP (ORDER BY x.ms) AS p99 FROM obs_grafana_calls c CROSS JOIN LATERAL unnest(c.turn_ms) AS x(ms) WHERE $__timeFilter(ts) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Time to first word p50 / p95",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ts,$__interval), percentile_cont(0.5) WITHIN GROUP (ORDER BY ttfw_ms) AS p50, percentile_cont(0.95) WITHIN GROUP (ORDER BY ttfw_ms) AS p95 FROM obs_grafana_calls WHERE $__timeFilter(ts) AND ttfw_ms IS NOT NULL GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Booking success (attempts that produced a booking)",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ts,$__interval), avg(booked::int) AS booking_success FROM obs_grafana_calls WHERE $__timeFilter(ts) AND booking_attempted GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tool failure rate",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ts,$__interval), sum(tool_failed)::float8 / nullif(sum(tool_total),0) AS tool_failure_rate FROM obs_grafana_calls WHERE $__timeFilter(ts) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Turn latency p95 by LLM provider",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ts,$__interval), llm_provider AS metric, percentile_cont(0.95) WITHIN GROUP (ORDER BY x.ms) AS p95 FROM obs_grafana_calls c CROSS JOIN LATERAL unnest(c.turn_ms) AS x(ms) WHERE $__timeFilter(ts) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Turn latency p95 by edge region",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ts,$__interval), region AS metric, percentile_cont(0.95) WITHIN GROUP (ORDER BY x.ms) AS p95 FROM obs_grafana_calls c CROSS JOIN LATERAL unnest(c.turn_ms) AS x(ms) WHERE $__timeFilter(ts) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Answer rate by dialed country code",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ts,$__interval), dial_code AS metric, avg(answered::int) AS answer_rate FROM obs_grafana_calls WHERE $__timeFilter(ts) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Flagged bad calls (long silence, repeats, hang-ups, low ASR, slow, tool failure)",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ts,$__interval), count(*) FILTER (WHERE flag_count > 0) AS flagged FROM obs_grafana_calls WHERE $__timeFilter(ts) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "ASR confidence (average) and barge-ins per call",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ts,$__interval), avg(asr_conf_avg) AS asr_confidence, avg(interruptions) AS barge_ins_per_call FROM obs_grafana_calls WHERE $__timeFilter(ts) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Audio quality (jitter ms, packet loss %, MOS) when the provider supplies it",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ts,$__interval), avg(jitter_ms) AS jitter_ms, avg(packet_loss_pct) AS packet_loss_pct, avg(mos) AS mos FROM obs_grafana_calls WHERE $__timeFilter(ts) AND (jitter_ms IS NOT NULL OR packet_loss_pct IS NOT NULL OR mos IS NOT NULL) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Alerts sent by severity",
      "description": "Pages per week and per severity feed the quarterly review in docs/incident/incident-management.md.",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ts,$__interval), severity AS metric, count(*) AS alerts FROM obs_grafana_alerts WHERE $__timeFilter(ts) AND kind = 'trigger' GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
